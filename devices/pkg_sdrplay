#!/bin/bash

###
### SIGPI
###
### pkg_sdrplay
###
### 20260910-0100
###
### Not a checkinstall/source-build package: unzips the proprietary vendor
### SDK ($SIGPI_DEBS/SDRplay_RSP_API.zip) already checked into the repo.
### API v3.15 confirmed as SDRplay's current major API version (see their
### published API spec); the exact 3.15.x sub-version of the checked-in zip
### was not independently re-verified.
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGPI_BANNER_COLOR}"
    echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGPI_BANNER_RESET}"
    exit 1
fi

# Fail fast on build errors: a failed compile/install step must not result
# in a broken .deb being staged or the package being marked installed.
# See sigpi_build_failed() in SIGpi_pkgbuild.
if [[ "$1" =~ ^(install|build|package)$ ]]; then
    set -Eeo pipefail
    trap 'sigpi_build_failed "${BASH_SOURCE[0]}" "$1" "$LINENO" "$?"' ERR
fi

case "$1" in 
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : SDRplay"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&

    remove|purge )
	    cd $SIGPI_SOURCE/SDRplay/build/host
        sudo make uninstall
        sudo ldconfig
        cd $SIGPI_SOURCE
        rm -rf $SIGPI_SOURCE/SDRplay
        rm -rf $HOME/.config/SDRplay
        sudo rm -rf $SIGPI_DESKTOP/SDRplay.desktop
        sudo rm -rf $DESKTOP_FILES/SDRplay.desktop
        sed -i /sdrplay/d $SIGPI_INSTALLED_DEVICES
        ;;&

    install )
        cd $SIGPI_SOURCE
        unzip $SIGPI_DEBS/SDRplay_RSP_API.zip
        cd SDRplay_RSP_API
        sudo ./install_lib.sh
        sudo cp $SIGPI_SCRIPTS/run_SDRplay.sh /usr/local/bin/run_SDRplay.sh
        sudo chmod 755 /usr/local/bin/run_SDRplay.sh
        cat $SIGPI_DEVLIST|grep "sdrplay" >> $SIGPI_INSTALLED_DEVICES
        ;;&

    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : SDRplay - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac