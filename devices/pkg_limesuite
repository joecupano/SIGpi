#!/bin/bash

###
### SIGpi
###
### pkg_limesuite
###
###
### 20260910-0100
###
### LimeSDR Devices
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGPI_BANNER_COLOR}"
    echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGPI_BANNER_RESET}"
    exit 1
fi

# Fail fast on build errors: a failed compile/install step must not result
# in a broken .deb being staged or the package being marked installed.
# See sigpi_build_failed() in SIGpi_pkgbuild.
if [[ "$1" =~ ^(install|build|package)$ ]]; then
    set -Eeo pipefail
    trap 'sigpi_build_failed "${BASH_SOURCE[0]}" "$1" "$LINENO" "$?"' ERR
fi

case "$1" in 
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : LimeSDR Devices"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&

    remove|purge )
        cd $SIGPI_SOURCE/LimeSuite/build-dir
        sudo make uninstall
        sudo ldconfig
        cd $SIGPI_SOURCE
	    rm -rf $SIGPI_SOURCE/LimeSuite
        sed -i /limesuite/d $SIGPI_INSTALLED_DEVICES
	
	    # Remove Menu icon
        sudo rm $SIGPI_DESKTOP_ICONS/LimeSuite.png
        # Remove Desktop links
        sudo rm $SIGPI_DESKTOP_FILES/LimeSuite.desktop
        ;;&
    
    install|build|package )
        ## DEPENDENCIES
        sudo apt-get install -y swig
        sudo apt-get install -y libsqlite3-dev
        sudo apt-get install -y libi2c-dev
        sudo apt-get install -y libusb-1.0-0-dev
        sudo apt-get install -y liboctave-dev
        sudo apt-get install -y libfltk1.3-dev
        sudo apt-get install -y libwxgtk3.0-gtk3-dev
        sudo apt-get install -y freeglut3-dev
        ;;&

    install )
        ## REPO
        sudo add-apt-repository -y ppa:myriadrf/drivers
        sudo apt-get update

        ## PACKAGE
        sudo apt-get install -y limesuite liblimesuite-dev limesuite-udev limesuite

        ## DESKTOP
        # Add Icon
        #sudo cp $SIGPI_SOURCE/LimeSuite/Desktop/*png $DESKTOP_ICONS
        #sudo cp $SIGPI_SOURCE/LimeSuite/Desktop/lime-suite-32.png $DESKTOP_ICONS/lime-suite.png
        # Add Desktop
        #sudo cp $SIGPI_SOURCE/LimeSuite/Desktop/lime-suite.desktop $DESKTOP_FILES
        # Change Category
        #sudo sed -i "s/Categories.*/Categories=$SIGPI_MENU_CATEGORY;/" $DESKTOP_FILES/lime-suite.desktop
        # Add to Menu
        #xdg-desktop-menu install --novendor --noupdate $DESKTOP_DIRECTORY/SIGpi.directory $DESKTOP_FILES/lime-suite.desktop

        cat $SIGPI_DEVLIST|grep "limesuite" >> $SIGPI_INSTALLED_DEVICES
        ;;&
    
    build|package)
        ## PACKAGE
        cd $SIGPI_SOURCE
        git clone https://github.com/myriadrf/LimeSuite.git
        cd LimeSuite
        git checkout v23.11.0 # pinned tag; "stable" is a moving branch
        mkdir build-dir && cd build-dir
        cmake .. -Wno-dev
        make -j4
        ;;&

    build )
        sudo make install
        cat $SIGPI_DEVLIST|grep "limesuite" >> $SIGPI_INSTALLED_DEVICES
        ;;&

    package)
        rm -rf pkgroot && mkdir -p pkgroot
        make DESTDIR="$(pwd)/pkgroot" install
        sigpi_stage_package "limesuite" "23.11.0" "$(pwd)/pkgroot" "LimeSDR LimeSuite drivers and utilities"
        rm -rf pkgroot
        ;;&

    install|build|package|remove|purge )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##   $1 : LimeSDR Devices completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;

    * )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unkown action or package"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac
