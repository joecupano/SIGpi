#!/bin/bash

###
### SIGpi
###
### pkg_sigutils
###
###
### 20260124-0400
###
### Digital signal processing library written in C, designed for blind signal analysis
### and automatic demodulation
###


if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGPI_BANNER_COLOR}"
    echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGPI_BANNER_RESET}"
    exit 1
fi

case "$1" in 
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : sigutils"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&

    remove )
        sudo dpkg -r sigutils
        sed -i /sigutils/d $SIGPI_INSTALLED
        ;;&

    purge )
        sudo dpkg -P sigutils
        sed -i /sigutils/d $SIGPI_INSTALLED
        ;;&

    install )
        ## PACKAGE
        cd $SIGPI_DEBS       
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        sudo dpkg -i sigutils_current_amd64.deb
            cat $SIGPI_PKGLIST|grep "sigutils" >> $SIGPI_INSTALLED
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        sudo dpkg -i sigutils_current_arm64.deb
            cat $SIGPI_PKGLIST|grep "sigutils" >> $SIGPI_INSTALLED
        fi
	    ;;&

    build|package )
        cd $SIGPI_SOURCE
        git clone https://github.com/BatchDrake/sigutils.git
        cd sigutils
        mkdir build && cd build
        cmake ..
        make -j4
        ;;&

    build )
        sudo make install
        sudo ldconfig
        cat $SIGPI_PKGLIST|grep "sigutils" >> $SIGPI_INSTALLED
        ;;&
    
    package )
        sudo checkinstall --install=no
        sudo mv *.deb $SIGPI_DEBS
	    ;;&

    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : sigutils - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac