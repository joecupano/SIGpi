#!/bin/bash

###
### SIGpi
###
### pkg_dsdcc
###
###
### 20260910-0100
###
### DSD is able to decode several digital voice formats from discriminator tap audio
### and synthesize the decoded speech. Speech synthesis requires mbelib, which is a separate package.
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGPI_BANNER_COLOR}"
    echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGPI_BANNER_RESET}"
    exit 1
fi

# Fail fast on build errors: a failed compile/install step must not result
# in a broken .deb being staged or the package being marked installed.
# See sigpi_build_failed() in SIGpi_pkgbuild.
if [[ "$1" =~ ^(install|build|package)$ ]]; then
    set -Eeo pipefail
    trap 'sigpi_build_failed "${BASH_SOURCE[0]}" "$1" "$LINENO" "$?"' ERR
fi

case "$1" in
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : DSDcc"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&

    remove )
	    cd $SIGPI_DEBS
        sudo dpkg -r dsdcc
        sed -i /dsdcc/d $SIGPI_INSTALLED
        sudo rm $DESKTOP_FILES/dsdcc.desktop
        ;;&

    purge )
        cd $SIGPI_DEBS
        sudo dpkg -P dsdcc
        sed -i /dsdcc/d $SIGPI_INSTALLED
        ;;&

    install )
        ## PACKAGE
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i dsdcc_current_amd64.deb
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i dsdcc_current_arm64.deb
        fi
        cat $SIGPI_PKGLIST|grep "dsdcc" >> $SIGPI_INSTALLED

	    ## DESKTOP
	    # Add Icon
        # Add Desktop
        sudo cp $SIGPI_DESKTOP/dsdcc.desktop $DESKTOP_FILES
        # Change Category
	    # Add to Menu
        ;;&
    
    build )
        ## DEPENDENCIES

        ## PACKAGE
        cd $SIGPI_SOURCE
        git clone https://github.com/f4exb/dsdcc.git
        cd dsdcc
        git reset --hard f27b32d   # v1.9.6 
        mkdir build; cd build
        cmake -Wno-dev -DUSE_MBELIB=ON ..
        make -j4
        sudo make install
        sudo ldconfig
        cat $SIGPI_PKGLIST|grep "dsdcc" >> $SIGPI_INSTALLED

	    ## DESKTOP
	    # Add Icon
        # Add Desktop
        # Change Category
	    # Add to Menu
        ;;&

    package )
        ## DEPENDENCIES

        ## PACKAGE
        cd $SIGPI_SOURCE
        git clone https://github.com/f4exb/dsdcc.git
        cd dsdcc
        git reset --hard f27b32d   # v1.9.6 
        mkdir build; cd build
        cmake -Wno-dev ..
        make -j4
        rm -rf pkgroot && mkdir -p pkgroot
        make DESTDIR="$(pwd)/pkgroot" install
        sigpi_stage_package "dsdcc" "1.9.6" "$(pwd)/pkgroot" "Digital Speech Decoder rewritten as a C++ library"
        rm -rf pkgroot

        ## DESKTOP
        # Add Icon
        # Add Desktop
        # Change Category
        # Add to Menu
	    ;;&

    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : DSDcc - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac
