#!/bin/bash

###
### SIGpi
###
### pkg_cm256cc  
###
###
### 20260910-0100
###
### cm256cc is a simple library for erasure codes. From given data it generates redundant data that can be used to recover the originals.
###
### The erasure code is parameterized by three values (OriginalCount, RecoveryCount, BlockBytes). These are:
###
###    The number of blocks of original data (OriginalCount), which must be less than 256.
###    The number of blocks of redundant data (RecoveryCount), which must be no more than 256 - OriginalCount.
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGPI_BANNER_COLOR}"
    echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGPI_BANNER_RESET}"
    exit 1
fi

# Fail fast on build errors: a failed compile/install step must not result
# in a broken .deb being staged or the package being marked installed.
# See sigpi_build_failed() in SIGpi_pkgbuild.
if [[ "$1" =~ ^(install|build|package)$ ]]; then
    set -Eeo pipefail
    trap 'sigpi_build_failed "${BASH_SOURCE[0]}" "$1" "$LINENO" "$?"' ERR
fi

case "$1" in
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : cm256cc"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&

    remove )
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
            sudo dpkg -r cm256cc
            sed -i /cm256cc/d $SIGPI_INSTALLED
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
            sudo dpkg -r cm256cc
            sed -i /cm256cc/d $SIGPI_INSTALLED
        fi
        ;;&

    purge )
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
            sudo dpkg -P cm256cc
            sed -i /cm256cc/d $SIGPI_INSTALLED
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
            sudo dpkg -P cm256cc
            sed -i /cm256cc/d $SIGPI_INSTALLED
        fi
        ;;&

    install )
        ## DEPENDENCIES

        ## PACKAGE
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i cm256cc_current_amd64.deb
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i cm256cc_current_arm64.deb
        fi
        cat $SIGPI_PKGLIST|grep "cm256cc" >> $SIGPI_INSTALLED

	    ## DESKTOP
	    # Add Icon
        # Add Desktop
        # Change Category
	    # Add to Menu
        ;;&

    build )
        ## DEPENDENCIES

        ## PACKAGE
        cd $SIGPI_SOURCE
        git clone https://github.com/f4exb/cm256cc.git
        cd cm256cc
        git reset --hard da87adb  #v1.1.2
        mkdir build; cd build
        cmake -Wno-dev ..
        make -j4
        sudo make install
        sudo ldconfig
        cat $SIGPI_PKGLIST|grep "cm256cc" >> $SIGPI_INSTALLED

	    ## DESKTOP
	    # Add Icon
        # Add Desktop
        # Change Category
	    # Add to Menu
        ;;&

    package )
        ## DEPENDENCIES

        ## PACKAGE
        cd $SIGPI_SOURCE
        git clone https://github.com/f4exb/cm256cc.git
        cd cm256cc
        git reset --hard da87adb  #v1.1.2
        mkdir build; cd build
        cmake -Wno-dev ..
        make -j4
        rm -rf pkgroot && mkdir -p pkgroot
        make DESTDIR="$(pwd)/pkgroot" install
        sigpi_stage_package "cm256cc" "1.1.2" "$(pwd)/pkgroot" "Fast GF(256) Cauchy MDS Block Erasure Codec in C++"
        rm -rf pkgroot

        ## DESKTOP
        # Add Icon
        # Add Desktop
        # Change Category
        # Add to Menu
        ;;&

    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : cm256cc - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac
