### libsigmf is a header-only C++ library for working with SigMF metadata.
###

case "$1" in 
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : LibSigMF"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&

    remove )
        cd $SIGPI_SOURCE/libsigmf/build
        sudo make uninstall
        sudo ldconfig
        rm -rf $SIGPI_SOURCE/libsigmf
        sed -i /libsigmf/d $SIGPI_INSTALLED
        ;;&

    purge )
        cd $SIGPI_SOURCE/libsigmf/build
        sudo make uninstall
        sudo ldconfig
        rm -rf $SIGPI_SOURCE/libsigmf
        sed -i /libsigmf/d $SIGPI_INSTALLED
        ;;&

    install|build )
        ## DEPENDENCIES

        ## PACKAGE
        cd $SIGPI_SOURCE
        git clone https://github.com/deepsig/libsigmf.git
        cd libsigmf
        mkdir build; cd build
        cmake .. -Wno-dev
        make -j4
        sudo make install
        sudo ldconfig
        cat $SIGPI_PKGLIST|grep "libsigmf,1.0,LibSigMF Library,20220101" >> $SIGPI_INSTALLED 
        
        ## DESKTOP
	    # Add Icon
        # Add Desktop
        # Change Category
	    # Add to Menu
        ;;&

    package )
        ## DEPENDENCIES

        ## PACKAGE
        cd $SIGPI_SOURCE
        git clone https://github.com/deepsig/libsigmf.git
        cd libsigmf
        mkdir build; cd build
        cmake .. -Wno-dev
        make -j4
        sudo checkinstall --install=no
        sudo mv *.deb $SIGPI_DEBS
        
        ## DESKTOP
	    # Add Icon
        # Add Desktop
        # Change Category
	    # Add to Menu
        ;;&
    
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : LibSigMF - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&
        
    * )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unkown action or package"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac
