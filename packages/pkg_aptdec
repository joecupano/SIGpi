#!/bin/bash

###
### SIGPI
###
### pkg_aptdec
###
###
### 20260112-2300
###
### Aptdec is a FOSS program that decodes images transmitted by NOAA weather satellites.
###

case "$1" in
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : APTdec (NOAA APT)"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&
    remove )
        cd $SIGPI_SOURCE/aptdec/build
        sudo make uninstall
        cd $SIGPI_SOURCE
        rm -rf $SIGPI_SOURCE/aptdec
        sed -i /aptdec/d $SIGPI_INSTALLED
        ;;&
    purge )
        cd $SIGPI_SOURCE/aptdec/build
        sudo make uninstall
        cd $SIGPI_SOURCE
        rm -rf $SIGPI_SOURCE/aptdec
        sed -i /aptdec/d $SIGPI_INSTALLED
        sudo rm -rf $SIGPI_DESKTOP/aptdec.desktop
        sudo rm -rf $DESKTOP_FILES/aptdec.desktop
        ;;&
    install|build|package )
        ## DEPENDENCIES
        sudo apt-get install -y libsndfile-dev libpng-dev
        ;;&    
    install )
        ## PACKAGE
        cd $SIGPI_SOURCE
        git clone --recursive https://github.com/Xerbo/aptdec.git
        cd aptdec
        cmake -B build
        cmake --build build
        cd build
        make -j4
        sudo make install
        sudo ldconfig
        cat $SIGPI_PKGLIST|grep "aptdec" >> $SIGPI_INSTALLED 

        ## DESKTOP
        # Add Icon
        # Add Desktop
        sudo cp $SIGPI_HOME/desktop/aptdec.desktop $DESKTOP_FILES
        # Change Category
        # Add to Menu
        xdg-desktop-menu install --novendor --noupdate $DESKTOP_DIRECTORY/SIGpishell.directory $DESKTOP_FILES/aptdec.desktop
        ;;&
    build )
        ## PACKAGE
        cd $SIGPI_SOURCE
        git clone --recursive https://github.com/Xerbo/aptdec.git
        cd aptdec
        cmake -B build
        cmake --build build
        cd build
        make -j4
        sudo make install
        sudo ldconfig
        cat $SIGPI_PKGLIST|grep "aptdec" >> $SIGPI_INSTALLED 

        ## DESKTOP
        # Add Icon
        # Add Desktop
        sudo cp $SIGPI_HOME/desktop/aptdec.desktop $DESKTOP_FILES
        # Change Category
        # Add to Menu
        xdg-desktop-menu install --novendor --noupdate $DESKTOP_DIRECTORY/SIGpishell.directory $DESKTOP_FILES/aptdec.desktop
        ;;&
    package )       
        ## PACKAGE
        git clone --recursive https://github.com/Xerbo/aptdec.git
        cd aptdec
        cmake -B build
        cmake --build build
        cd build
        make -j4
        sudo checkinstall --install=no
        sudo mv *.deb $SIGPI_DEBS

        ## DESKTOP
        # Add Icon
        # Add Desktop
        # Change Category
        # Add to Menu
        ;;&
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : APTdec (NOAA APT) - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&
    * )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unkown action or package"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac
