#!/bin/bash

###
### SIGpi
###
### pkg_sdrangel
###
###
### 20260912-0000
###
### SDRangel package management script
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGPI_BANNER_COLOR}"
    echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGPI_BANNER_RESET}"
    exit 1
fi

# Fail fast on build errors: a failed compile/install step must not result
# in a broken .deb being staged or the package being marked installed.
# See sigpi_build_failed() in SIGpi_pkgbuild.
if [[ "$1" =~ ^(install|build|package)$ ]]; then
    set -Eeo pipefail
    trap 'sigpi_build_failed "${BASH_SOURCE[0]}" "$1" "$LINENO" "$?"' ERR
fi

case "$1" in 
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : SDRangel"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&

    build|package )
        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
            echo -e "${SIGPI_BANNER_COLOR}"
            echo -e "${SIGPI_BANNER_COLOR} ##  $1 : Not supported for arm64 (Raspberry Pi)"
            echo -e "${SIGPI_BANNER_COLOR} ##"
            echo -e "${SIGPI_BANNER_COLOR} ##  SDRangel is not built from source for arm64 here. SDRangel's own"
            echo -e "${SIGPI_BANNER_COLOR} ##  wiki (Hardware requirements) says even a Pi 4 is underpowered for"
            echo -e "${SIGPI_BANNER_COLOR} ##  the GUI application, and a native build on Debian trixie/aarch64"
            echo -e "${SIGPI_BANNER_COLOR} ##  hits an unresolved upstream link failure against libunwind's"
            echo -e "${SIGPI_BANNER_COLOR} ##  aarch64 unwinder (undefined references to _Uaarch64_*, see"
            echo -e "${SIGPI_BANNER_COLOR} ##  f4exb/sdrangel issue #2741, no fix upstream yet)."
            echo -e "${SIGPI_BANNER_COLOR} ##"
            echo -e "${SIGPI_BANNER_COLOR} ##  Run 'install' instead to install the pre-built"
            echo -e "${SIGPI_BANNER_COLOR} ##  debs/sdrangel_current_arm64.deb, or use pkg_sdrangelsrv"
            echo -e "${SIGPI_BANNER_COLOR} ##  (headless server, BUILD_GUI=off) and drive it remotely from a"
            echo -e "${SIGPI_BANNER_COLOR} ##  full SDRangel GUI client."
            echo -e "${SIGPI_BANNER_RESET}"
            exit
        fi
        ;;&

    remove )
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
            sudo dpkg -r sdrangel
            sed -i /sdrangel/d $SIGPI_INSTALLED
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
            sudo dpkg -r sdrangel
            sed -i /sdrangel/d $SIGPI_INSTALLED
        fi
        ;;&

    purge )
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
            sudo dpkg -P sdrangel
            sed -i /sdrangel/d $SIGPI_INSTALLED
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
            sudo dpkg -P sdrangel
            sed -i /sdrangel/d $SIGPI_INSTALLED
        fi
        ;;&

    install|build|package )
        ## DEPENDENCIES
        sudo apt-get install -y libfftw3-dev
        sudo apt-get install -y libusb-1.0-0-dev
        sudo apt-get install -y libusb-dev
        sudo apt-get install -y libboost-all-dev
        sudo apt-get install -y libasound2-dev
        sudo apt-get install -y libgl1-mesa-dev
        sudo apt-get install -y libunwind-dev
        sudo apt-get install -y gettext
        sudo apt-get install -y pulseaudio
        sudo apt-get install -y libopencv-dev
        sudo apt-get install -y libopencv-imgcodecs-dev
        sudo apt-get install -y libxml2-dev
        sudo apt-get install -y bison
        sudo apt-get install -y flex
        sudo apt-get install -y ffmpeg
        sudo apt-get install -y libavcodec-dev
        sudo apt-get install -y libavformat-dev
        sudo apt-get install -y opus-tools
        sudo apt-get install -y libopus-dev
        sudo apt-get install -y libfaad-dev
        sudo apt-get install -y libflac-dev
        sudo apt-get install -y zlib1g-dev
        sudo apt-get install -y ca-certificates
        sudo apt-get install -y libavahi-client-dev
        sudo apt-get install -y libavahi-common-dev
        sudo apt-get install -y libaio-dev
        sudo apt-get install -y xxd
        sudo apt-get install -y libhidapi-dev
        sudo apt-get install -y libairspy-dev
        sudo apt-get install -y libairspyhf-dev
        sudo apt-get install -y libsoapysdr-dev
        sudo apt-get install -y python3-numpy
        sudo apt-get install -y python3-mako
        sudo apt-get install -y python3-cheetah
        sudo apt-get install -y graphviz
        sudo apt-get install -y qt5-qmake
        sudo apt-get install -y qtscript5-dev
        sudo apt-get install -y qtbase5-dev
        #sudo apt-get install -y qtbase5-dev-tool
        sudo apt-get install -y qtchooser
        sudo apt-get install -y qtmultimedia5-dev
        sudo apt-get install -y qtwebengine5-dev
        sudo apt-get install -y qml-module-qtlocation
        sudo apt-get install -y qml-module-qtpositioning
        sudo apt-get install -y qml-module-qtquick-window2
        sudo apt-get install -y qml-module-qtquick-dialogs
        sudo apt-get install -y qml-module-qtquick-controls
        sudo apt-get install -y qml-module-qtquick-controls2
        sudo apt-get install -y qml-module-qtquick-layouts
        sudo apt-get install -y qml-module-qtgraphicaleffects
        sudo apt-get install -y qttools5-dev
        sudo apt-get install -y qttools5-dev-tools
        sudo apt-get install -y qtdeclarative5-dev
        sudo apt-get install -y qtpositioning5-dev
        sudo apt-get install -y qtlocation5-dev
        sudo apt-get install -y qtbase5-dev
        sudo apt-get install -y libgl1
        sudo apt-get install -y libqt5opengl5-dev
        sudo apt-get install -y libqt5quick5
        sudo apt-get install -y libqt5charts5-dev
        sudo apt-get install -y libqt5websockets5-dev
        sudo apt-get install -y libqt5multimedia5-plugins
        sudo apt-get install -y libqt5serialport5-dev
        sudo apt-get install -y libqt5texttospeech5-dev
        sudo apt-get install -y libqt5svg5-dev 
        sudo apt-get install -y libqt5serialport5-dev
        sudo apt-get install -y libqt5positioning5
        sudo apt-get install -y libqt5positioning5-plugins
        sudo apt-get install -y libqt5gamepad5-dev
        sudo apt-get install -y gstreamer1.0-libav
        ;;&

    install )    
        ## PACKAGE
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i sdrangel_current_amd64.deb
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
	        SDRANGEL_ARM64_VERSION="$(dpkg-deb -f sdrangel_current_arm64.deb Version 2>/dev/null)"
	        echo -e "${SIGPI_BANNER_COLOR}"
	        echo -e "${SIGPI_BANNER_COLOR} ##  Installing pre-built sdrangel_current_arm64.deb"
	        echo -e "${SIGPI_BANNER_COLOR} ##  SDRangel version: ${SDRANGEL_ARM64_VERSION:-unknown}"
	        echo -e "${SIGPI_BANNER_COLOR} ##  (not built from source on arm64 - see 'build'/'package' for why)"
	        echo -e "${SIGPI_BANNER_RESET}"
	        sudo dpkg -i sdrangel_current_arm64.deb
        fi
        cat $SIGPI_PKGLIST|grep "sdrangel," >> $SIGPI_INSTALLED
        ;;&

    build|package )
        ## x86_64 only - the aarch64 case exits above.
        cd $SIGPI_SOURCE
        git clone https://github.com/f4exb/sdrangel.git
        cd sdrangel
        #git reset --hard c4e57a1  # v7.22.5
        #git reset --hard 502e751   # v7.22.10
        #git reset --hard 1236b11   # v7.23.0
        git reset --hard 97e9e21   # v7.27.2
        mkdir build && cd build
        cmake -Wno-dev ..
        make -j4
        ;;&

    build  )
        sudo make install
        sudo ldconfig
        cat $SIGPI_PKGLIST|grep "sdrangel," >> $SIGPI_INSTALLED
        ;;&

    package )
        rm -rf pkgroot && mkdir -p pkgroot
        make DESTDIR="$(pwd)/pkgroot" install
        sigpi_stage_package "sdrangel" "7.27.2" "$(pwd)/pkgroot" "Open-source Qt5 OpenGL 3.0+ SDR and signal analyzer"
        rm -rf pkgroot
        ;;&

    install|build )
	    ## DESKTOP
        # Add Icon      
        # Add Desktop
        sudo cp $SIGPI_DESKTOP/sdrangel.desktop $DESKTOP_FILES
        # Add Run script
        sudo cp $SIGPI_SCRIPTS/run_sdrangel.sh /usr/local/bin
        # Change Category
        # Add to Menu
        xdg-desktop-menu install --novendor --noupdate $DESKTOP_DIRECTORY/SIGpi.directory $DESKTOP_FILES/sdrangel.desktop

        ### FFTW-WISDOM CHECK AND LINK
        mkdir $HOME/.config/f4exb
        mkdir $HOME/.local/share/f4exb
        mkdir $HOME/.local/share/f4exb/SDRangel
        if [ ! -f "$SIGPI_ETC/fftw-wisdom" ]; then
            fftwf-wisdom -v -n -o $SIGPI_ETC/fftw-wisdom 128 256 512 1024 2048 4096 8192 16384 32768
        fi
        cp $SIGPI_ETC/fftw-wisdom $HOME/.local/share/f4exb/SDRangel/fftw-wisdom
        cp $SIGPI_ETC/fftw-wisdom $HOME/.config/f4exb/fftw-wisdom
        ;;&
    
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : SDRangel - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac
