#!/bin/bash

###
### SIGpi
###
### pkg_inmarsatc
###
###
### 20260910-0100
###
### C++ library with functions to receive Inmarsat-C signals 
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGPI_BANNER_COLOR}"
    echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGPI_BANNER_RESET}"
    exit 1
fi

# Fail fast on build errors: a failed compile/install step must not result
# in a broken .deb being staged or the package being marked installed.
# See sigpi_build_failed() in SIGpi_pkgbuild.
if [[ "$1" =~ ^(install|build|package)$ ]]; then
    set -Eeo pipefail
    trap 'sigpi_build_failed "${BASH_SOURCE[0]}" "$1" "$LINENO" "$?"' ERR
fi

case "$1" in 
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : inmarsatc"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&

    remove )
        sudo dpkg -r inmarsatc
        sed -i /inmarsatc/d $SIGPI_INSTALLED
        ;;&

    purge )
        sudo dpkg -P inmarsatc
        sed -i /inmarsatc/d $SIGPI_INSTALLED
        ;;&

    install )
        ## PACKAGE
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i inmarsatc_current_amd64.deb
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i inmarsatc_current_arm64.deb
        fi
        cat $SIGPI_PKGLIST|grep "inmarsatc," >> $SIGPI_INSTALLED 
        ;;&
        
    build )
        ## PACKAGE
        cd $SIGPI_SOURCE
        git clone https://github.com/srcejon/inmarsatc.git
        cd inmarsatc
        git checkout msvc
        git reset --hard a8e5797 # no tagged releases upstream; pinned to msvc branch HEAD as of 2026-01-12
        mkdir build; cd build
        cmake ..
        make -j4
        sudo make install
        sudo ldconfig
        cat $SIGPI_PKGLIST|grep "inmarsatc" >> $SIGPI_INSTALLED
        ;;&

    package )
        ## PACKAGE
        cd $SIGPI_SOURCE
        git clone https://github.com/srcejon/inmarsatc.git
        cd inmarsatc
        git checkout msvc
        git reset --hard a8e5797 # no tagged releases upstream; pinned to msvc branch HEAD as of 2026-01-12
        mkdir build; cd build
        cmake ..
        make -j4
        rm -rf pkgroot && mkdir -p pkgroot
        make DESTDIR="$(pwd)/pkgroot" install
        sigpi_stage_package "inmarsatc" "1.0" "$(pwd)/pkgroot" "C++ library with functions to receive Inmarsat-C signals"
        rm -rf pkgroot
        ;;&

    remove|purge|install|build|package|config )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : InmarsatC - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac