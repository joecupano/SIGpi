#!/bin/bash

###
### SIGpi
###
### pkg_serialdv
###
###
### 20260910-0100
###
### SerialDV is inspired from the OpenDV project but retains only
### the minimal interface to encode and decode audio with AMBE3000 based devices
### in packet mode over a serial link.
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGPI_BANNER_COLOR}"
    echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGPI_BANNER_RESET}"
    exit 1
fi

# Fail fast on build errors: a failed compile/install step must not result
# in a broken .deb being staged or the package being marked installed.
# See sigpi_build_failed() in SIGpi_pkgbuild.
if [[ "$1" =~ ^(install|build|package)$ ]]; then
    set -Eeo pipefail
    trap 'sigpi_build_failed "${BASH_SOURCE[0]}" "$1" "$LINENO" "$?"' ERR
fi

case "$1" in 
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : SerialDV"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&

    remove )
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
            sudo dpkg -r serialdv
            sed -i /serialdv/d $SIGPI_INSTALLED
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
            sudo dpkg -r serialdv
            sed -i /serialdv/d $SIGPI_INSTALLED
        fi
        ;;&

    purge )
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
            sudo dpkg -P serialdv
            sed -i /serialdv/d $SIGPI_INSTALLED
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
            sudo dpkg -P serialdv
            sed -i /serialdv/d $SIGPI_INSTALLED
        fi
        ;;&

    install )
        ## PACKAGE
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i serialdv_current_amd64.deb
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i serialdv_current_arm64.deb
        fi
        cat $SIGPI_PKGLIST|grep "serialdv" >> $SIGPI_INSTALLED
        ;;&

    build )
        ## DEPENDENCIES

        ## PACKAGE
        cd $SIGPI_SOURCE
        git clone https://github.com/f4exb/serialDV.git
        cd serialDV
        git reset --hard "v1.1.5"
        mkdir build; cd build
        cmake -Wno-dev ..
        make -j4
        sudo make install
        sudo ldconfig
        cat $SIGPI_PKGLIST|grep "serialdv" >> $SIGPI_INSTALLED

        ## DESKTOP
	    # Add Icon
        # Add Desktop
        # Change Category
	    # Add to Menu
        ;;&

    package )
        ## DEPENDENCIES

        ## PACKAGE
        cd $SIGPI_SOURCE
        git clone https://github.com/f4exb/serialDV.git
        cd serialDV
        git reset --hard "v1.1.5"
        mkdir build; cd build
        cmake -Wno-dev ..
        make -j4
        rm -rf pkgroot && mkdir -p pkgroot
        make DESTDIR="$(pwd)/pkgroot" install
        sigpi_stage_package "serialdv" "1.1.5" "$(pwd)/pkgroot" "C++ interface encode/decode audio with AMBE3000 devices serial link"
        rm -rf pkgroot
        
        ## DESKTOP
	    # Add Icon
        # Add Desktop
        # Change Category
	    # Add to Menu
        ;;&

     remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : SerialDV - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac
