###
###
### 20260117-2300
###
### Codec 2 is an open source (LGPL 2.1) low bit rate speech codec: http://rowetel.com/codec2.html
###
### Also included:
###
###    The FreeDV API for digital voice over radio. FreeDV is an open source digital voice protocol that integrates modems, codecs, and FEC README_freedv
###    APIs for raw and Ethernet packet data over radio README_data
###    High performance coherent OFDM modem for HF channels README_ofdm
###    High performance non-coherent FSK modem README_fsk
###    An STM32 embedded version of FreeDV 1600/700D/700E for the SM1000
###    Coherent PSK modem README_cohpsk for HF channels
###    FDMDV DPSK modem README_fdmdv for HF channels
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGPI_BANNER_COLOR}"
    echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGPI_BANNER_RESET}"
    exit 1
fi

case "$1" in
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : Codec 2"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;& 

    remove )
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
            sudo dpkg -r codec2
            sed -i /codec2/d $SIGPI_INSTALLED
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
            sudo dpkg -r codec2
            sed -i /codec2/d $SIGPI_INSTALLED
        fi
        ;;&

    purge )
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
            sudo dpkg -P codec2
            sed -i /codec2/d $SIGPI_INSTALLED
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
            sudo dpkg -P codec2
            sed -i /codec2/d $SIGPI_INSTALLED
        fi
        ;;&

    install )
        ## PACKAGE
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i codec2_current_amd64.deb
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i codec2_current_arm64.deb
        fi
        cat $SIGPI_PKGLIST|grep "codec2" >> $SIGPI_INSTALLED

	    ## DESKTOP
	    # Add Icon
        # Add Desktop
        # Change Category
	    # Add to Menu
        ;;&
    
    build )
        ## DEPENDENCIES

        ## PACKAGE
        cd $SIGPI_SOURCE
        git clone https://github.com/drowe67/codec2.git
        cd codec2
        git reset --hard 06d4c11 # v1.20
        mkdir build; cd build
        cmake -Wno-dev ..
        make -j4
        sudo make install
        sudo ldconfig
        cat $SIGPI_PKGLIST|grep "codec2" >> $SIGPI_INSTALLED 

	    ## DESKTOP
	    # Add Icon
        # Add Desktop
        # Change Category
	    # Add to Menu
        ;;&

    package )
        ## DEPENDENCIES

        ## PACKAGE
        cd $SIGPI_SOURCE
        git clone https://github.com/drowe67/codec2.git
        cd codec2
        git reset --hard 06d4c11 # v1.20
        mkdir build; cd build
        cmake -Wno-dev ..
        make -j4
        sudo checkinstall --install=no
        sudo mv *.deb $SIGPI_DEBS

        ## DESKTOP
        # Add Icon
        # Add Desktop
        # Change Category
        # Add to Menu
        ;;&

    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : Codec 2 - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac
