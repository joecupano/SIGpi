#!/bin/bash

###
### SIGPI
###
### pkg_ax25
###
### 20260112-2300
###
### Packet Radio AX.25
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGPI_BANNER_COLOR}"
    echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGPI_BANNER_RESET}"
    exit 1
fi

case "$1" in
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : AX.25"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&
    remove )
        sudo apt-get remove -y libncurses5 libax25 ax25-apps ax25-tools
        ;;&
    purge )
        sudo apt-get remove -y libncurses5 libax25 ax25-apps ax25-tools
        sudo rm -rf /etc/ax25/axports
        ;;&
    install )
        sudo apt-get install -y libncurses5 libax25 ax25-apps ax25-tools
        echo "ax0 N0CALL-3 1200 255 7 APRS" | sudo tee -a /etc/ax25/axports
        ;;&
    build )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  Build option not available"
        echo -e "${SIGPI_BANNER_RESET}"
	    ;;&
    package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  Package option not available"
        echo -e "${SIGPI_BANNER_RESET}"
	    ;;&
    remove|purge|install )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : AX.25 - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac
