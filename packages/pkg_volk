#!/bin/bash

###
### SIGpi
###
### pkg_volk
###
###
###  20260113-2300
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGPI_BANNER_COLOR}"
    echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGPI_BANNER_RESET}"
    exit 1
fi

case "$1" in 
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : VOLK"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&

    remove|purge )
        cd $SIGPI_SOURCE/volk/build
        sudo make uninstall
        sudo ldconfig
        rm -rf $SIGPI_SOURCE/volk
        ;;&

    install|build )
        cd $SIGPI_SOURCE 
        git clone https://github.com/gnuradio/volk.git
        cd volk
        git checkout v3.2.0
        mkdir build && cd build
        git submodule update --init
        cmake -DCMAKE_BUILD_TYPE=Release -DPYTHON_EXECUTABLE=/usr/bin/python3 -DENABLE_MANPAGES=OFF ../
        make -j4
        make test
        sudo make install
        sudo ldconfig
        ;;&
    
    package )
        cd $SIGPI_SOURCE 
        git clone https://github.com/gnuradio/volk.git
        cd volk
        git checkout v3.2.0
        mkdir build && cd build
        git submodule update --init
        cmake -DCMAKE_BUILD_TYPE=Release -DPYTHON_EXECUTABLE=/usr/bin/python3 ../
        make -j4
        sudo checkinstall --install=no
        sudo mv *.deb $SIGPI_DEBS
        ;;&
    
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : VOLK - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac
    

