if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGPI_BANNER_COLOR}"
    echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGPI_BANNER_RESET}"
    exit 1
fi

case "$1" in
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : Audacity"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&
    remove )
        sudo apt-get remove audacity
        sed -i /audacity/d $SIGPI_INSTALLED
        ;;&
    purge )
        sudo apt-get remove --purge audacity
        sed -i /audacity/d $SIGPI_INSTALLED
        ;;&
    install )
        ## DEPENDENCIES

        ## PACKAGE
        cd $SIGPI_SOURCE
        sudo apt-get install -y audacity
        cat $SIGPI_PKGLIST|grep "audacity" >> $SIGPI_INSTALLED

        ## DESKTOP
	    # Add Icon
        # Add Desktop
        # Add Category
        # Add to Menu

        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##   Audacity Installed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&
    build )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##   Build option not available"
        echo -e "${SIGPI_BANNER_RESET}"
	    ;;&
    package )
        echo -e "${SIGPI_BANNER_COLOR}"        #git reset --hard 74e3303  # v2.32.0
        git reset --hard e711403   # v2.41.5
        echo -e "${SIGPI_BANNER_COLOR} ##   Package option not available"
        echo -e "${SIGPI_BANNER_RESET}"
	    ;;&
    remove|purge|install )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : Audacity - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac
