###
### pkg_flrig
###
###
### 20260910-0100
###
### FLrig installation script for SIGPI
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGPI_BANNER_COLOR}"
    echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGPI_BANNER_RESET}"
    exit 1
fi

case "$1" in
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : FLrig"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&

    remove )
        sudo dpkg -r flrig
        sed -i /flrig/d $SIGPI_INSTALLED
        ;;&

    purge )
        sudo dpkg -P flrig
        sed -i /flrig/d $SIGPI_INSTALLED
        ;;&

    install )
        ## DEPENDENCIES

        ## PACKAGE
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i flrig_current_amd64.deb
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i flrig_current_arm64.deb
        fi
        cat $SIGPI_PKGLIST|grep "flrig" >> $SIGPI_INSTALLED

	    ## DESKTOP
	    # Add Icon
        # Add Desktop
        # Add Category
        # Add to Menu.
        ;;&

    build|package )
        wget -qO- "https://www.w1hkj.org/files/flrig/flrig-2.0.12.tar.gz" | tar -xz -C $SIGPI_SOURCE
        cd $SIGPI_SOURCE
        cd flrig-2.0.12
        ./configure
        make -j4
	    ;;&

    build )
        sudo make install
        cat $SIGPI_PKGLIST|grep "flrig" >> $SIGPI_INSTALLED
        ;;&

    package )
        rm -rf pkgroot && mkdir -p pkgroot
        make DESTDIR="$(pwd)/pkgroot" install
        sigpi_stage_package "flrig" "2.0.12" "$(pwd)/pkgroot" "Rig control program that cooperates with fldigi"
        rm -rf pkgroot
	    ;;&

    remove|purge|install )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : FLrig - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac