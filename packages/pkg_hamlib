#!/bin/bash

###
### SIGpi
###
### pkg_hamlib
###
###
### 20260910-0100
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGPI_BANNER_COLOR}"
    echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGPI_BANNER_RESET}"
    exit 1
fi

# Fail fast on build errors: a failed compile/install step must not result
# in a broken .deb being staged or the package being marked installed.
# See sigpi_build_failed() in SIGpi_pkgbuild.
if [[ "$1" =~ ^(install|build|package)$ ]]; then
    set -Eeo pipefail
    trap 'sigpi_build_failed "${BASH_SOURCE[0]}" "$1" "$LINENO" "$?"' ERR
fi

case "$1" in 
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : Hamlib"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&

    remove )
        cd $SIGPI_DEBS
        sudo dpkg -r hamlib
        sed -i /hamlib/d $SIGPI_INSTALLED
        ;;&

    purge )
        cd $SIGPI_DEBS
        sudo dpkg -P hamlib
        sed -i /hamlib/d $SIGPI_INSTALLED
        ;;&

    install )
        ## DEPENDENCIES

        ## PACKAGE
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i hamlib_current_amd64.deb
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i hamlib_current_arm64.deb
        fi
        cat $SIGPI_PKGLIST|grep "hamlib" >> $SIGPI_INSTALLED

        ## DESKTOP
	    # Add Icon
        # Add Desktop
        # Change Category
	    # Add to Menu
        ;;&

    build )
        ## DEPENDENCIES

        ## PACKAGE
        cd $SIGPI_SOURCE
        git clone https://github.com/Hamlib/Hamlib
        cd Hamlib
        git reset --hard 40f6348 # v4.7.2
        ./bootstrap
        ./configure
        make -j4
        sudo make install
        sudo ldconfig
        
        ## DESKTOP
	    # Add Icon
        # Add Desktop
        # Change Category
	    # Add to Menu
        ;;&

    package )
        ## PACKAGE
        cd $SIGPI_SOURCE
        git clone https://github.com/Hamlib/Hamlib
        cd Hamlib
        git reset --hard 40f6348 # v4.7.2
        ./bootstrap
        ./configure
        make -j4
        rm -rf pkgroot && mkdir -p pkgroot
        make DESTDIR="$(pwd)/pkgroot" install
        sigpi_stage_package "hamlib" "4.7.2" "$(pwd)/pkgroot" "Radio Control Library providing API for controlling radios and rotators"
        rm -rf pkgroot
        ;;&

    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : Hamlib - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac
