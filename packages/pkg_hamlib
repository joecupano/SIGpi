#!/bin/bash

###
### SIGpi
###
### pkg_hamlib
###
###
### 20260113-2300
###

case "$1" in 
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : Hamlib"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&

    remove )
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
            sudo dpkg -r hamlib
            sed -i /hamlib/d $SIGPI_INSTALLED
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
            sudo dpkg -r hamlib
            sed -i /hamlib/d $SIGPI_INSTALLED
        fi
        ;;&

    purge )
        sudo dpkg -r hamlib
        sed -i /hamlib/d $SIGPI_INSTALLED
        sudo rm -rf $SIGPI_SOURCE/hamlib*
        sed -i /hamlib/d $SIGPI_INSTALLED
        ;;&

    install )
        ## DEPENDENCIES

        ## PACKAGE
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i hamlib_current_amd64.deb
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i hamlib_current_arm64.deb
        fi
        cat $SIGPI_PKGLIST|grep "hamlib" >> $SIGPI_INSTALLED

        ## DESKTOP
	    # Add Icon
        # Add Desktop
        # Change Category
	    # Add to Menu
        ;;&

    build )
        ## DEPENDENCIES

        ## PACKAGE
        cd $SIGPI_SOURCE
        wget https://github.com/Hamlib/Hamlib
        cd Hamlib
        ./bootstrap
        ./configure
        make -j4
        sudo make install
        sudo ldconfig
        
        ## DESKTOP
	    # Add Icon
        # Add Desktop
        # Change Category
	    # Add to Menu
        
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##   Hamlib Installed. Debian package available in $SIG_DEBS"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&

    package )
        ## PACKAGE
        cd $SIGPI_SOURCE
        wget https://github.com/Hamlib/Hamlib
        cd Hamlib
        ./bootstrap
        ./configure
        make -j4
        sudo checkinstall --install=no
        sudo mv *.deb $SIGPI_DEBS
        ;;&

    remove|purge|install )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : Hamlib - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&

    * )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unkown action or package"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac
