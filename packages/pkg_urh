#!/bin/bash

###
### SIGPI
###
### pkg_urh
###
###
### 20260910-0100
###
### Universal Radio hacker install
###
### NOTE: upstream jopohl/urh was archived (read-only, no more releases/fixes) on
### 2026-03-29, pinned here at its final release, v2.10.0.
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGPI_BANNER_COLOR}"
    echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGPI_BANNER_RESET}"
    exit 1
fi

case "$1" in 
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : Universal Radio Hacker (URH)"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&

    remove )
        sudo python3 -m pip uninstall urh
        sed -i /urh/d $SIGPI_INSTALLED
        sudo rm -f $DESKTOP_FILES/urh.desktop
        ;;&

    purge )
        sudo python3 -m pip uninstall urh
        sed -i /urh/d $SIGPI_INSTALLED
        sudo rm -f $DESKTOP_FILES/urh.desktop
        ;;&

    install|build )
        ## DEPENDENCIES
        sudo python3 -m pip install setuptools
        sudo python3 -m pip install cython

        ## PACKAGE
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_SOURCE
            git clone https://github.com/jopohl/urh.git
            cd urh
            git checkout v2.10.0
            sudo python setup.py install

            ## DESKTOP
	        # Add Icon
            #sudo cp $SIGPI_ICONS/myicon.png $DESKTOP_ICONS
            # Add Desktop
            sudo cp $SIGPI_DESKTOP/urh.desktop $DESKTOP_FILES
            # Change Category
            # Add to Menu
  
            cat $SIGPI_PKGLIST|grep "urh" >> $SIGPI_INSTALLED
        else
            echo -e "${SIGPI_BANNER_COLOR}"
            echo -e "${SIGPI_BANNER_COLOR} ##   URH not available for Raspberry Pi OS (aarch64)"
            echo -e "${SIGPI_BANNER_COLOR} ##"
            echo -e "${SIGPI_BANNER_COLOR} ##   As of 2026-09 upstream (now archived/unmaintained) has two open,"
            echo -e "${SIGPI_BANNER_COLOR} ##   unfixed reports specific to this target: a Cython/numpy build"
            echo -e "${SIGPI_BANNER_COLOR} ##   failure installing on a Raspberry Pi 5 running trixie with"
            echo -e "${SIGPI_BANNER_COLOR} ##   Python 3.13 (jopohl/urh#1203), and incorrect signal magnitude/"
            echo -e "${SIGPI_BANNER_COLOR} ##   demodulation results on Raspberry Pi 5 aarch64 (jopohl/urh#1160)."
            echo -e "${SIGPI_BANNER_COLOR} ##   Since the repo is archived, neither will be"
            echo -e "${SIGPI_BANNER_COLOR} ##   fixed upstream, so it stays disabled here."
            echo -e "${SIGPI_BANNER_RESET}"
        fi
        ;;&

    package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : option not available"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&
        
    remove|purge|install )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : Universal Radio Hacker (URH) - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac