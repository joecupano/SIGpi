### DOSbox package script
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGPI_BANNER_COLOR}"
    echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGPI_BANNER_RESET}"
    exit 1
fi

case "$1" in 
    remove )
        sudo apt-get remove dosbox
        rm -rf $SIGPI_SOURCE/dosbox-radio
        sed -i /dosbox/d $SIGPI_INSTALLED
        ;;&

    purge )
        sudo apt-get remove --purge dosbox
        rm -rf $SIGPI_SOURCE/dosbox-radio
        sed -i /dosbox/d $SIGPI_INSTALLED
        rm $SIGPI_ETC/sigpi_dosbox.conf
        ;;&

    install )
        ## DEPENDENCIES

        ## PACKAGE
        cd $SIGPI_SOURCE
        sudo apt-get install -y dosbox
        cp $SIGPI_HOME/config_dosbox-TEMPLATE $SIGPI_ETC/sigpi_dosbox.conf
        cat $SIGPI_PKGLIST|grep "dosbox" >> $SIGPI_INSTALLED

        ## DESKTOP
	    # Add Icon
        # Add Desktop
        sudo cp $SIGPI_HOME/desktop/dosbox.desktop $DESKTOP_FILES
        # Add Category
        # Add to Menu
        # Add DOS Radio Apps
        # tar -zxvf $SIGPI_PACKAGES/dosbox-radio.tar.gz -C $SIGPI_SOURCE
        ;;&

    build )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##   Build option not available"
        echo -e "${SIGPI_BANNER_RESET}"
	    ;;
    package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##   Package option not available"
        echo -e "${SIGPI_BANNER_RESET}"
	    ;;&

    remove|purge|install|build|package|config )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : DOSbox - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac