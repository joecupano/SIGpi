#!/bin/bash

###
### SIGpi
###
### pkg_ggmorse
###
###
### 20260910-0100
###
### Morse code decoding library
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGPI_BANNER_COLOR}"
    echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGPI_BANNER_RESET}"
    exit 1
fi

# Fail fast on build errors: a failed compile/install step must not result
# in a broken .deb being staged or the package being marked installed.
# See sigpi_build_failed() in SIGpi_pkgbuild.
if [[ "$1" =~ ^(install|build|package)$ ]]; then
    set -Eeo pipefail
    trap 'sigpi_build_failed "${BASH_SOURCE[0]}" "$1" "$LINENO" "$?"' ERR
fi

case "$1" in 
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : GGmorse"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&

    remove )
        sudo dpkg -r ggmorse
        sed -i /ggmorse/d $SIGPI_INSTALLED
        ;;&

    purge )
        sudo dpkg -P ggmorse
        sed -i /ggmorse/d $SIGPI_INSTALLED
        ;;&

    install|build|package )
        ## DEPENDENCIES
        sudo apt install -y libsdl2-dev
        ;;&

    install )
        ## PACKAGE
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i ggmorse_current_amd64.deb
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i ggmorse_current_arm64.deb
        fi
        cat $SIGPI_PKGLIST|grep "ggmorse," >> $SIGPI_INSTALLED 
        ;;&
        
    build )
        ## PACKAGE
        cd $SIGPI_SOURCE
        git clone https://github.com/ggerganov/ggmorse --recursive
        cd ggmorse
        git reset --hard 7b4822a # no tagged releases upstream; pinned to HEAD as of 2026-08-24
        mkdir build && cd build
        cmake .. -Wno-dev -DGGMORSE_BUILD_TESTS=OFF -DGGMORSE_BUILD_EXAMPLES=OFF ..
        make -j4
        sudo make install
        sudo ldconfig
        cat $SIGPI_PKGLIST|grep "ggmorse" >> $SIGPI_INSTALLED
        ;;&

    package )
        ## PACKAGE
        cd $SIGPI_SOURCE
        git clone https://github.com/ggerganov/ggmorse --recursive
        cd ggmorse
        git reset --hard 7b4822a # no tagged releases upstream; pinned to HEAD as of 2026-08-24
        mkdir build && cd build
        cmake .. -Wno-dev -DGGMORSE_BUILD_TESTS=OFF -DGGMORSE_BUILD_EXAMPLES=OFF ..
        make -j4
        rm -rf pkgroot && mkdir -p pkgroot
        make DESTDIR="$(pwd)/pkgroot" install
        sigpi_stage_package "ggmorse" "1.0" "$(pwd)/pkgroot" "Morse code decoding library"
        rm -rf pkgroot
        ;;&

    remove|purge|install|build|package|config )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : GGmorse - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac
