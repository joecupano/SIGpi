#!/bin/bash

###
### SIGpi
###
### pkg_sigdigger
###
###
### 20260115-2300
###
### SigDigger is a free digital signal analyzer for GNU/Linux and macOS, designed to extract
### information of unknown radio signals. It supports a variety of SDR devices through SoapySDR, and
### allows adjustable demodulation of FSK, PSK and ASK signals, decode analog video, analyze
### bursty signals and listen to analog voice channels (all in real time).
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGPI_BANNER_COLOR}"
    echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGPI_BANNER_RESET}"
    exit 1
fi

case "$1" in 
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : SigDigger"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&

    remove )
        sudo dpkg -r sigdigger
        sudo dpkg -r suwidgets
        sudo dpkg -r suscan
        sudo dpkg -r sigutils
        
        sed -i /sigdigger/d $SIGPI_INSTALLED
        sed -i /suwidgets/d $SIGPI_INSTALLED
        sed -i /suscan/d $SIGPI_INSTALLED
        sed -i /sigutils/d $SIGPI_INSTALLED
        ;;&

    purge )
        sudo dpkg -P sigdigger
        sudo dpkg -P suwidgets
        sudo dpkg -P suscan
        sudo dpkg -P sigutils
        
        sed -i /sigdigger/d $SIGPI_INSTALLED
        sed -i /suwidgets/d $SIGPI_INSTALLED
        sed -i /suscan/d $SIGPI_INSTALLED
        sed -i /sigutils/d $SIGPI_INSTALLED

        sudo rm -rf $SIGPI_DESKTOP/sigdigger.desktop
        sudo rm -rf $DESKTOP_FILES/sigdigger.desktop
        ;;&

    install)
        ## PACKAGE
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i sigdigger_current_amd64.deb
            sudo dpkg -i suwidgets_current_amd64.deb
            sudo dpkg -i suscan_current_amd64.deb
            sudo dpkg -i sigutils_current_amd64.deb
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i sigdigger_current_arm64.deb
            sudo dpkg -i suwidgets_current_arm64.deb
            sudo dpkg -i suscan_current_arm64.deb
            sudo dpkg -i sigutils_current_arm64.deb
        fi
        cat $SIGPI_PKGLIST|grep "sigdigger" >> $SIGPI_INSTALLED

	    ## DESKTOP
	    # Add Icon
        # Add Desktop
        # Change Category
	    # Add to Menu
        ;;&

    build )
        cd $SIGPI_SOURCE
        git clone --recursive https://github.com/BatchDrake/sigutils
        cd sigutils 
        mkdir -p build && cd build 
        cmake .. 
        make 
        sudo make install
        cd ../..

        cd $SIGPI_SOURCE
        git clone --recursive https://github.com/BatchDrake/suscan
        cd suscan 
        mkdir -p build && cd build 
        cmake .. 
        make 
        sudo make install 
        cd ../..

        cd $SIGPI_SOURCE
        git clone https://github.com/BatchDrake/SuWidgets
        cd SuWidgets 
        qmake6 SuWidgetsLib.pro 
        make 
        sudo make install 
        cd ..

        cd $SIGPI_SOURCE
        git clone https://github.com/BatchDrake/SigDigger
        cd SigDigger 
        qmake6 SigDigger.pro 
        make 
        sudo make install 
        cd ..

        ## DESKTOP
        # Add Icon      
        # Add Desktop
        sudo cp $SIGPI_DESKTOP/sigdigger.desktop $DESKTOP_FILES
        # Add Run script
        # Change Category
        # Add to Menu
        xdg-desktop-menu install --novendor --noupdate $DESKTOP_DIRECTORY/SIGpi.directory $DESKTOP_FILES/sigdigger.desktop
        ;;&

    package )
        git clone --recursive https://github.com/BatchDrake/sigutils
        cd sigutils
        mkdir -p build && cd build 
        cmake .. 
        make 
        sudo checkinstall --install=no
        sudo mv *.deb $SIGPI_DEBS
        cd ../..

        git clone --recursive https://github.com/BatchDrake/suscan
        cd suscan 
        mkdir -p build && cd build 
        cmake .. 
        make 
        sudo checkinstall --install=no
        sudo mv *.deb $SIGPI_DEBS
        cd ../..

        git clone https://github.com/BatchDrake/SuWidgets
        cd SuWidgets 
        qmake6 SuWidgetsLib.pro 
        make 
        sudo checkinstall --install=no
        sudo mv *.deb $SIGPI_DEBS 
        cd ..

        git clone https://github.com/BatchDrake/SigDigger
        cd SigDigger 
        qmake6 SigDigger.pro 
        make 
        sudo checkinstall --install=no
        sudo mv *.deb $SIGPI_DEBS
        cd ..
        ;;&

    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : SigDigger - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac