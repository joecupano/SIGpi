#!/bin/bash

###
### SIGpi
###
### pkg_sigdigger
###
###
### 20260613-2300
###
### SigDigger is a free digital signal analyzer for GNU/Linux, designed to extract
### information of unknown radio signals. It supports a wide range of SDR devices
### through SoapySDR and provides blind parameter estimation, cyclostationary and
### transition analysis, and adjustable demodulation of FSK, PSK, ASK, analog voice
### and analog video signals.
###
### Builds sigutils and suscan (BatchDrake DSP/analyzer libraries) and SuWidgets
### (Qt widget library) as dependencies before building SigDigger itself, all
### pinned to release v0.3.0.
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGPI_BANNER_COLOR}"
    echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGPI_BANNER_RESET}"
    exit 1
fi

SIGDIGGER_TAG="v0.3.0"

case "$1" in
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : SigDigger"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&

    remove )
        for proj in SigDigger SuWidgets suscan sigutils; do
            if [[ -d "$SIGPI_SOURCE/$proj/build" ]]; then
                cd "$SIGPI_SOURCE/$proj/build"
                sudo make uninstall || true
            fi
        done
        sudo ldconfig
        sed -i /sigdigger/d $SIGPI_INSTALLED
        sudo rm -f $DESKTOP_FILES/sigdigger.desktop
        ;;&

    purge )
        for proj in SigDigger SuWidgets suscan sigutils; do
            if [[ -d "$SIGPI_SOURCE/$proj/build" ]]; then
                cd "$SIGPI_SOURCE/$proj/build"
                sudo make uninstall || true
            fi
        done
        sudo ldconfig
        sed -i /sigdigger/d $SIGPI_INSTALLED
        sudo rm -f $DESKTOP_FILES/sigdigger.desktop
        sudo rm -rf $SIGPI_SOURCE/sigutils $SIGPI_SOURCE/suscan $SIGPI_SOURCE/SuWidgets $SIGPI_SOURCE/SigDigger
        ;;&

    install|build|package )
        ## DEPENDENCIES
        sudo apt-get install -y build-essential cmake pkg-config
        sudo apt-get install -y libfftw3-dev libsndfile1-dev libxml2-dev libsoapysdr-dev
        sudo apt-get install -y qtbase5-dev qt5-qmake libqt5opengl5-dev libqt5svg5-dev qttools5-dev
        ;;&

    install|build )
        ## SIGUTILS - blind signal analysis DSP library
        cd $SIGPI_SOURCE
        git clone --recursive https://github.com/BatchDrake/sigutils
        cd sigutils
        git checkout $SIGDIGGER_TAG
        mkdir -p build && cd build
        cmake -Wno-dev ..
        make -j4
        sudo make install
        sudo ldconfig

        ## SUSCAN - realtime DSP analyzer library (depends on sigutils)
        cd $SIGPI_SOURCE
        git clone --recursive https://github.com/BatchDrake/suscan
        cd suscan
        git checkout $SIGDIGGER_TAG
        mkdir -p build && cd build
        cmake -Wno-dev ..
        make -j4
        sudo make install
        sudo ldconfig

        ## SUWIDGETS - Qt widget library (depends on sigutils, suscan)
        cd $SIGPI_SOURCE
        git clone https://github.com/BatchDrake/SuWidgets
        cd SuWidgets
        git checkout $SIGDIGGER_TAG
        qmake SuWidgetsLib.pro
        make -j4
        sudo make install
        sudo ldconfig

        ## SIGDIGGER - depends on sigutils, suscan, SuWidgets
        cd $SIGPI_SOURCE
        git clone https://github.com/BatchDrake/SigDigger
        cd SigDigger
        git checkout $SIGDIGGER_TAG
        qmake SigDigger.pro
        make -j4
        sudo make install
        sudo ldconfig

        cat $SIGPI_PKGLIST|grep "sigdigger," >> $SIGPI_INSTALLED

        ## DESKTOP
        sudo cp $SIGPI_DESKTOP/sigdigger.desktop $DESKTOP_FILES
        xdg-desktop-menu install --novendor --noupdate $DESKTOP_DIRECTORY/SIGpi.directory $DESKTOP_FILES/sigdigger.desktop
        ;;&

    package )
        ## SIGUTILS
        cd $SIGPI_SOURCE
        git clone --recursive https://github.com/BatchDrake/sigutils
        cd sigutils
        git checkout $SIGDIGGER_TAG
        mkdir -p build && cd build
        cmake -Wno-dev ..
        make -j4
        sudo checkinstall -y
        sudo ldconfig
        sudo mv *.deb $SIGPI_DEBS

        ## SUSCAN (depends on sigutils, installed above)
        cd $SIGPI_SOURCE
        git clone --recursive https://github.com/BatchDrake/suscan
        cd suscan
        git checkout $SIGDIGGER_TAG
        mkdir -p build && cd build
        cmake -Wno-dev ..
        make -j4
        sudo checkinstall -y
        sudo ldconfig
        sudo mv *.deb $SIGPI_DEBS

        ## SUWIDGETS (depends on sigutils, suscan)
        cd $SIGPI_SOURCE
        git clone https://github.com/BatchDrake/SuWidgets
        cd SuWidgets
        git checkout $SIGDIGGER_TAG
        qmake SuWidgetsLib.pro
        make -j4
        sudo checkinstall -y
        sudo ldconfig
        sudo mv *.deb $SIGPI_DEBS

        ## SIGDIGGER (depends on sigutils, suscan, SuWidgets)
        cd $SIGPI_SOURCE
        git clone https://github.com/BatchDrake/SigDigger
        cd SigDigger
        git checkout $SIGDIGGER_TAG
        qmake SigDigger.pro
        make -j4
        sudo checkinstall -y
        sudo mv *.deb $SIGPI_DEBS
        ;;&

    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : SigDigger - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac
