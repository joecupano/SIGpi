#!/bin/bash

###
### SIGpi
###
### pkg_sdrangelsrv
###
###
### 20260910-0100
###
### SDRangel Server package management script
###
### sdrangelsrv,7.27.2,Open-source SDR server,20260910
###
### Headless (BUILD_GUI=off) counterpart to pkg_sdrangel. SDRangel's own wiki
### (Hardware requirements) recommends armv8/aarch64 boards such as the
### Raspberry Pi 3B/4/5 specifically for this server-only build, unlike the
### full GUI app - so unlike pkg_sdrangel this script does NOT exclude aarch64.
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGPI_BANNER_COLOR}"
    echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGPI_BANNER_RESET}"
    exit 1
fi

# Fail fast on build errors: a failed compile/install step must not result
# in a broken .deb being staged or the package being marked installed.
# See sigpi_build_failed() in SIGpi_pkgbuild.
if [[ "$1" =~ ^(install|build|package)$ ]]; then
    set -Eeo pipefail
    trap 'sigpi_build_failed "${BASH_SOURCE[0]}" "$1" "$LINENO" "$?"' ERR
fi

case "$1" in 
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : SDRangel Server"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&

    remove )
        sudo dpkg -r sdrangel
        sed -i /sdrangelsrv/d $SIGPI_INSTALLED
        rm $HOME/.config/f4exb/fftw-wisdom
        rm $HOME/.local/share/f4exb/SDRangel/fftw-wisdom
        ;;&

    purge )
        sudo dpkg -P sdrangel
        sed -i /sdrangelsrv/d $SIGPI_INSTALLED
        rm $HOME/.config/f4exb/fftw-wisdom
        rm $HOME/.local/share/f4exb/SDRangel/fftw-wisdom
        ;;&

    install|build|package )
        ## DEPENDENCIES
        sudo apt-get install -y libfftw3-dev
        sudo apt-get install -y libusb-1.0-0-dev
        sudo apt-get install -y libusb-dev
        sudo apt-get install -y libboost-all-dev
        sudo apt-get install -y libasound2-dev
        sudo apt-get install -y libgl1-mesa-dev
        sudo apt-get install -y libunwind-dev
        sudo apt-get install -y gettext
        sudo apt-get install -y pulseaudio
        sudo apt-get install -y libopencv-dev
        sudo apt-get install -y libopencv-imgcodecs-dev
        sudo apt-get install -y libxml2-dev
        sudo apt-get install -y bison
        sudo apt-get install -y flex
        sudo apt-get install -y ffmpeg
        sudo apt-get install -y libavcodec-dev
        sudo apt-get install -y libavformat-dev
        sudo apt-get install -y opus-tools
        sudo apt-get install -y libopus-dev
        sudo apt-get install -y libfaad-dev
        sudo apt-get install -y libflac-dev
        sudo apt-get install -y zlib1g-dev
        sudo apt-get install -y ca-certificates
        sudo apt-get install -y libavahi-client-dev
        sudo apt-get install -y libavahi-common-dev
        sudo apt-get install -y libaio-dev
        sudo apt-get install -y xxd
        sudo apt-get install -y libhidapi-dev
        sudo apt-get install -y libairspy-dev
        sudo apt-get install -y libairspyhf-dev
        sudo apt-get install -y libsoapysdr-dev
        sudo apt-get install -y python3-numpy
        sudo apt-get install -y python3-mako
        sudo apt-get install -y python3-cheetah
        ## Qt5 - CMakeLists.txt requires these unconditionally (Core, Widgets,
        ## WebSockets, Multimedia, MultimediaWidgets, Positioning, Charts,
        ## SerialPort), even with -DBUILD_GUI=off - none were previously
        ## captured here, so a from-scratch headless build/install (e.g. on
        ## a bare Raspberry Pi) would fail cmake configure outright
        sudo apt-get install -y qtbase5-dev
        sudo apt-get install -y qttools5-dev
        sudo apt-get install -y qttools5-dev-tools
        sudo apt-get install -y qtmultimedia5-dev
        sudo apt-get install -y libqt5multimedia5-plugins
        sudo apt-get install -y qtpositioning5-dev
        sudo apt-get install -y libqt5charts5-dev
        sudo apt-get install -y libqt5serialport5-dev
        sudo apt-get install -y libqt5websockets5-dev
        sudo apt-get install -y qml-module-qtlocation
        sudo apt-get install -y qml-module-qtpositioning
        sudo apt-get install -y qml-module-qtquick-window2
        sudo apt-get install -y qml-module-qtquick-dialogs
        sudo apt-get install -y qml-module-qtquick-controls
        sudo apt-get install -y qml-module-qtquick-layouts
        ;;&

    install )
        ## PACKAGE
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i sdrangelsrv_current_amd64.deb
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i sdrangelsrv_current_arm64.deb
        fi
        cat $SIGPI_PKGLIST|grep "sdrangelsrv" >> $SIGPI_INSTALLED 
        
        ### FFTW-WISDOM CHECK AND LINK
        mkdir $HOME/.config/f4exb
        mkdir $HOME/.local/share/f4exb
        mkdir $HOME/.local/share/f4exb/SDRangel
        if [ ! -f "$SIGPI_ETC/fftw-wisdom" ]; then
            fftwf-wisdom -v -n -o $SIGPI_ETC/fftw-wisdom 128 256 512 1024 2048 4096 8192 16384 32768
        fi
        cp $SIGPI_ETC/fftw-wisdom $HOME/.local/share/f4exb/SDRangel/fftw-wisdom
        cp $SIGPI_ETC/fftw-wisdom $HOME/.config/f4exb/SDRangel/fftw-wisdom
        ;;&

    build|package )
        ## PACKAGE
        cd $SIGPI_SOURCE
        git clone https://github.com/f4exb/sdrangel.git
        cd sdrangel
        #git reset --hard c4e57a1  # v7.22.5
        #git reset --hard 502e751  # v7.22.10
        #git reset --hard 1236b11  # v7.23.0
        git reset --hard 97e9e21   # v7.27.2
        mkdir build && cd build
        cmake .. -Wno-dev -DBUILD_GUI=off
        make -j4
        ;;&

    build )
        sudo make install
        sudo ldconfig
        ;;&

    package )
        rm -rf pkgroot && mkdir -p pkgroot
        make DESTDIR="$(pwd)/pkgroot" install
        sigpi_stage_package "sdrangelsrv" "7.27.2" "$(pwd)/pkgroot" "Open-source SDR server (headless SDRangel)"
        rm -rf pkgroot
        ;;&
    
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : SDRangel Server - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac
