if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGPI_BANNER_COLOR}"
    echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGPI_BANNER_RESET}"
    exit 1
fi

case "$1" in 
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : SGP4"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&

    remove )
        cd $SIGPI_SOURCE/sgp4/build
        sudo make uninstall
        sudo ldconfig
        rm -rf $SIGPI_SOURCE/sgp4
        sed -i /sgp4/d $SIGPI_INSTALLED
        ;;&

    purge )
        cd $SIGPI_SOURCE/sgp4/build
        sudo make uninstall
        sudo ldconfig
        rm -rf $SIGPI_SOURCE/sgp4
        sed -i /sgp4/d $SIGPI_INSTALLED
        ;;&

    install|build )
        ## DEPENDENCIES

        ## PACKAGE
        # python-sgp4 1.4-1 is available in the packager, installing this version just to be sure.
        cd $SIGPI_SOURCE
        git clone https://github.com/dnwrnr/sgp4.git
        cd $SIGPI_SOURCE/sgp4
        mkdir build; cd build
        cmake .. -Wno-dev
        make -j4
        sudo make install
        sudo ldconfig
        cat $SIGPI_PKGLIST|grep "sgp4,1.0,SGP4 Library,20170101" >> $SIGPI_INSTALLED

        ## DESKTOP
	    # Add Icon
        # Add Desktop
        # Change Category
	    # Add to Menu
        ;;&

    package )
        ## DEPENDENCIES

        ## PACKAGE
        # python-sgp4 1.4-1 is available in the packager, installing this version just to be sure.
        cd $SIGPI_SOURCE
        git clone https://github.com/dnwrnr/sgp4.git
        cd $SIGPI_SOURCE/sgp4
        mkdir build; cd build
        cmake .. -Wno-dev
        make -j4
        sudo checkinstall --install=no
        sudo mv *.deb $SIGPI_DEBS
        
        ## DESKTOP
	    # Add Icon
        # Add Desktop
        # Change Category
	    # Add to Menu
        ;;&
    
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : SGP4 - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac
