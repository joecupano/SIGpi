#!/bin/bash

###
### SIGpi
###
### pkg_bettercap
###
###
### 20260110-2300
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGPI_BANNER_COLOR}"
    echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGPI_BANNER_RESET}"
    exit 1
fi

case "$1" in 
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : bettercap"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&

    remove )
        sudo dpkg -r bettercap
        sed -i /bettercap/d $SIGPI_INSTALLED
        ;;&

    purge )
        sudo dpkg -P bettercap
        rm -rf $SIGPI_SOURCE/bettercap
        sed -i /bettercap/d $SIGPI_INSTALLED

        rm -rf $HOME/.config/bettercap
        sudo rm -rf $SIGPI_DESKTOP/bettercap.desktop
        sudo rm -rf $DESKTOP_FILES/bettercap.desktop
        ;;&

    install )
        # DEPENDENCIES
        sudo apt-get install -y libpcap-dev libnetfilter-queue-dev
        sudo apt-get install -y golang-1.23-go
        
        ## PACKAGE
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i bettercap_current_amd64.deb
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i bettercap_current_arm64.deb
        fi
        cat $SIGPI_PKGLIST|grep "bettercap" >> $SIGPI_INSTALLED 
	
	    ## DESKTOP
	    # Add Icon
        # Add Desktop
        sudo cp $SIGPI_HOME/desktop/bettercap.desktop $DESKTOP_FILES
        # Change Category
	    sudo sed -i "s/Categories.*/Categories=$SIGPI_MENU_CATEGORY;/" $DESKTOP_FILES/bettercap.desktop
        # Add to Menu
        xdg-desktop-menu install --novendor --noupdate $DESKTOP_DIRECTORY/SIGpi.directory $DESKTOP_FILES/bettercap.desktop
        ;;&

    build )
        # DEPENDENCIES
        sudo apt-get install -y libpcap-dev libnetfilter-queue-dev
        sudo apt-get install -y golang-1.23-go
        
        ## PACKAGE 
        cd $SIGPI_SOURCE
        git clone https://github.com/bettercap/bettercap
        cd bettercap
        #git reset --hard 74e3303  # v2.32.0
        git reset --hard e711403   # v2.41.5
        make build
        sudo make install
        ;;&

    package)
        # DEPENDENCIES
        sudo apt-get install -y libpcap-dev libnetfilter-queue-dev
        sudo apt-get install -y golang-1.23-go
        
        ## PACKAGE 
        cd $SIGPI_SOURCE
        git clone https://github.com/bettercap/bettercap
        cd bettercap
        #git reset --hard 74e3303  # v2.32.0
        git reset --hard e711403   # v2.41.5
        make build
        sudo checkinstall --install=no
        sudo mv *.deb $SIGPI_DEBS
        ;;&

    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : bettercap - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac
