if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGPI_BANNER_COLOR}"
    echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGPI_BANNER_RESET}"
    exit 1
fi

case "$1" in 
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : bettercap"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&

    remove )
        sudo apt remove -y bettercap
        sudo apt autoremove -y
        sed -i /bettercap/d $SIGPI_INSTALLED
        sudo rm $DESKTOP_FILES/bettercap.desktop
        ;;&

    purge )
        # Remove the package and system configs
        sudo apt purge -y bettercap
        sudo apt autoremove -y

        # Remove the modules and caplets directory
        sudo rm -rf /usr/local/share/bettercap
        sudo rm -rf /usr/share/bettercap

        # Remove user-specific data for the current root user and standard users
        sudo rm -rf ~/.bettercap
        sudo rm $DESKTOP_FILES/bettercap.desktop
        ;;&

    install|build|package )
        # DEPENDENCIES
        sudo apt-get install -y libpcap-dev libusb-1.0-0-dev libnetfilter-queue-dev
        ;;&
    
    install )
        # PACKAGE
        sudo apt-get install -y bettercap
        # Bettercap uses its own internal command to download modules
        sudo bettercap -eval "caplets.update; q"
        cat $SIGPI_PKGLIST|grep "bettercap" >> $SIGPI_INSTALLED 
	
	    ## DESKTOP
	    # Add Icon
        #sudo cp $SIGPI_ICONS/bettercap.icon $DESKTOP_ICONS
        # Add Desktop
        sudo cp $SIGPI_DESKTOP/bettercap.desktop $DESKTOP_FILES
        # Change Category
	    # Add to Menu
        ;;&

    build )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##   Build option not available"
        echo -e "${SIGPI_BANNER_RESET}"
	    ;;&

    package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##   Package option not available"
        echo -e "${SIGPI_BANNER_RESET}"
	    ;;&

    remove|purge|install )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : bettercap - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac
