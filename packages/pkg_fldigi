#!/bin/bash

###
### SIGPI
###
### pkg_fldigi
###
###
### 20260910-0100
###
### FLdigi installation script
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGPI_BANNER_COLOR}"
    echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGPI_BANNER_RESET}"
    exit 1
fi

# Fail fast on build errors: a failed compile/install step must not result
# in a broken .deb being staged or the package being marked installed.
# See sigpi_build_failed() in SIGpi_pkgbuild.
if [[ "$1" =~ ^(install|build|package)$ ]]; then
    set -Eeo pipefail
    trap 'sigpi_build_failed "${BASH_SOURCE[0]}" "$1" "$LINENO" "$?"' ERR
fi

case "$1" in
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : FLdigi"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&

    remove )
        sudo dpkg -r fldigi
        sed -i /fldigi/d $SIGPI_INSTALLED
        ;;&

    purge )
        sudo dpkg -P fldigi
        sed -i /fldigi/d $SIGPI_INSTALLED
        ;;&

    install )
        ## DEPENDENCIES

        ## PACKAGE
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i fldigi_current_amd64.deb
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i fldigi_current_arm64.deb
        fi
        cat $SIGPI_PKGLIST|grep "fldigi" >> $SIGPI_INSTALLED

	    ## DESKTOP
	    # Add Icon
        # Add Desktop
        # Add Category
        # Add to Menu.
        ;;&

    build|package )
        wget -qO- "https://www.w1hkj.org/files/fldigi/fldigi-4.2.13.tar.gz" | tar -xz -C $SIGPI_SOURCE
        cd $SIGPI_SOURCE
        cd fldigi-4.2.13
        ./configure
        make -j4
	    ;;&

    build )
        sudo make install
        cat $SIGPI_PKGLIST|grep "fldigi" >> $SIGPI_INSTALLED
        ;;&

    package )
        rm -rf pkgroot && mkdir -p pkgroot
        make DESTDIR="$(pwd)/pkgroot" install
        sigpi_stage_package "fldigi" "4.2.13" "$(pwd)/pkgroot" "Soundcard modem program for most of the digital modes used by radio amateurs"
        rm -rf pkgroot
	    ;;&

    remove|purge|install )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : FLdigi - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac