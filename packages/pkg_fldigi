### FLdigi installation script
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGPI_BANNER_COLOR}"
    echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGPI_BANNER_RESET}"
    exit 1
fi

case "$1" in
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : FLdigi"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&

    remove )
        sudo dpkg -r fldigi
        sed -i /fldigi/d $SIGPI_INSTALLED
        ;;&

    purge )
        sudo dpkg -P fldigi
        sed -i /fldigi/d $SIGPI_INSTALLED
        ;;&

    install )
        ## DEPENDENCIES

        ## PACKAGE
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i fldigi_current_amd64.deb
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i fldigi_current_arm64.deb
        fi
        cat $SIGPI_PKGLIST|grep "fldigi" >> $SIGPI_INSTALLED

	    ## DESKTOP
	    # Add Icon
        # Add Desktop
        # Add Category
        # Add to Menu.
        ;;&

    build )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##   Build option not available"
        echo -e "${SIGPI_BANNER_RESET}"
	    ;;&

    package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##   Package option not available"
        echo -e "${SIGPI_BANNER_RESET}"
	    ;;&

    remove|purge|install )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : FLdigi - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac