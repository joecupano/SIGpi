#!/bin/bash

###
### SIGpi
###
### pkg_libdab
###
###
### 20260910-0100
###
### The DAB library provides entries for the functionality to handle DAB/DAB+ through some simple calls.
### A few callback functions provide the communication back from the library to the caller.
### The library interface is given in dab-api.h
###
### Upstream JvanKatwijk/dab-cmdline has no real tagged releases (its only git tag,
### dab-cmdline-0.8, dates from 2017); pinned below to the latest commit on the
### default branch as of 2026-09 for reproducibility (previously an unpinned clone
### of master HEAD).
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGPI_BANNER_COLOR}"
    echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGPI_BANNER_RESET}"
    exit 1
fi

# Fail fast on build errors: a failed compile/install step must not result
# in a broken .deb being staged or the package being marked installed.
# See sigpi_build_failed() in SIGpi_pkgbuild.
if [[ "$1" =~ ^(install|build|package)$ ]]; then
    set -Eeo pipefail
    trap 'sigpi_build_failed "${BASH_SOURCE[0]}" "$1" "$LINENO" "$?"' ERR
fi

case "$1" in 
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : LibDAB"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&

    remove )
        sudo dpkg -r libdab
        sed -i /libdab/d $SIGPI_INSTALLED
        ;;&

    purge )
        sudo dpkg -P libdab
        sed -i /libdab/d $SIGPI_INSTALLED
        ;;&

    install|build|package )
        ## DEPENDENCIES
        sudo apt-get install -y libsndfile1-dev
        sudo apt-get install -y libfftw3-dev portaudio19-dev
        sudo apt-get install -y libfaad-dev zlib1g-dev
        #sudo apt-get install -y mesa-common-dev libgl1-mesa-dev
        ;;&

    install )
        ## PACKAGE
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i libdab_current_amd64.deb
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i libdab_current_arm64.deb
        fi
        cat $SIGPI_PKGLIST|grep "libdab," >> $SIGPI_INSTALLED 
        ;;&
        
    build )
        ## PACKAGE
        cd $SIGPI_SOURCE
        git clone https://github.com/JvanKatwijk/dab-cmdline.git
        cd dab-cmdline
        git checkout 8b82305 # latest commit as of 2026-06 (no tagged release since dab-cmdline-0.8, 2017)

        cd $SIGPI_SOURCE/dab-cmdline/library
        mkdir build && cd build
        cmake .. -Wno-dev
        make -j4
        sudo make install
        sudo ldconfig

        cd $SIGPI_SOURCE/dab-cmdline/example-2
        mkdir build && cd build
        cmake .. -DRTLSDR=on
        sudo make install
        sudo ldconfig
        cat $SIGPI_PKGLIST|grep "libdab" >> $SIGPI_INSTALLED
        ;;&

    package )
        ## PACKAGE
        cd $SIGPI_SOURCE
        git clone https://github.com/JvanKatwijk/dab-cmdline.git
        cd dab-cmdline
        git checkout 8b82305 # latest commit as of 2026-06 (no tagged release since dab-cmdline-0.8, 2017)
        rm -rf pkgroot && mkdir -p pkgroot

        cd $SIGPI_SOURCE/dab-cmdline/library
        mkdir build && cd build
        cmake .. -Wno-dev
        make -j4
        make DESTDIR="$SIGPI_SOURCE/dab-cmdline/pkgroot" install

        cd $SIGPI_SOURCE/dab-cmdline/example-2
        mkdir build && cd build
        cmake .. -DRTLSDR=on
        make -j4
        make DESTDIR="$SIGPI_SOURCE/dab-cmdline/pkgroot" install

        # Both the library and the example-2 CLI tool are staged into one shared
        # pkgroot so they land in a single libdab_current_<arch>.deb, matching
        # what the install case above expects.
        sigpi_stage_package "libdab" "2026.06" "$SIGPI_SOURCE/dab-cmdline/pkgroot" "DAB/DAB+ decoding library and command-line example"
        rm -rf $SIGPI_SOURCE/dab-cmdline/pkgroot
        ;;&

    remove|purge|install|build|package|config )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : LibDAB - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac