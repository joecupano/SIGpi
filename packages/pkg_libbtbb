#!/bin/bash

###
### SIGpi
###
### pkg_libbtbb
###
###
### 20260113-2300
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGPI_BANNER_COLOR}"
    echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGPI_BANNER_RESET}"
    exit 1
fi

case "$1" in 
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : LibBTbb"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&

    remove )
        cd $SIGPI_SOURCE/libbtbb/build
        sudo make uninstall
        sudo ldconfig
        rm -rf $SIGPI_SOURCE/libbtbb
        sed -i /libbtbb/d $SIGPI_INSTALLED
        ;;&

    purge )
        cd $SIGPI_SOURCE/libbtbb/build
        sudo make uninstall
        sudo ldconfig
        rm -rf $SIGPI_SOURCE/libbtbb
        sed -i /libbtbb/d $SIGPI_INSTALLED
        ;;&

    install|build )
        ## DEPENDNCIES

        ## PACKAGE
        cd $SIGPI_SOURCE
        git clone https://github.com/greatscottgadgets/libbtbb.git
        cd libbtbb
        mkdir build && cd build
        cmake .. -Wno-dev
        make -j4
        sudo make install
        sudo ldconfig
        cat $SIGPI_PKGLIST|grep "libbtbb" >> $SIGPI_INSTALLED 

        ### BTBR Plugin
        git clone https://github.com/greatscottgadgets/libbtbb/wireshark/plugins/btbredr.git
        cd $SIGPI_SOURCE/libbtbb/wireshark/plugins/btbredr
        mkdir build && cd build
        cmake -DCMAKE_INSTALL_LIBDIR=/usr/lib/x86_64-linux-gnu/wireshark/libwireshark3/plugins ..
        make -j4
        sudo make install
        sudo ldconfig

        ## DESKTOP
	    # Add Icon
        # Add Desktop
        # Change Category
	    # Add to Menu
        ;;&

    package )
        ## DEPENDNCIES

        ## PACKAGE
        cd $SIGPI_SOURCE
        git clone https://github.com/greatscottgadgets/libbtbb.git
        cd libbtbb
        mkdir build && cd build
        cmake .. -Wno-dev
        make -j4
        sudo checkinstall --install=no
        sudo mv *.deb $SIGPI_DEBS

        ### BTBR Plugin
        git clone https://github.com/greatscottgadgets/libbtbb/wireshark/plugins/btbredr.git
        cd $SIGPI_SOURCE/libbtbb/wireshark/plugins/btbredr
        mkdir build && cd build
        cmake -DCMAKE_INSTALL_LIBDIR=/usr/lib/x86_64-linux-gnu/wireshark/libwireshark3/plugins ..
        make -j4
        sudo checkinstall --install=no
        sudo mv *.deb $SIGPI_DEBS

        ## DESKTOP
	    # Add Icon
        # Add Desktop
        # Change Category
	    # Add to Menu
        ;;&
    
     remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : LibBTbb - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac
