#!/bin/bash

###
### SIGpi
###
### pkg_fftw
###
###
### 20260910-0100
###
### FFTW Package Script
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGPI_BANNER_COLOR}"
    echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGPI_BANNER_RESET}"
    exit 1
fi

# Fail fast on build errors: a failed compile/install step must not result
# in a broken .deb being staged or the package being marked installed.
# See sigpi_build_failed() in SIGpi_pkgbuild.
if [[ "$1" =~ ^(install|build|package)$ ]]; then
    set -Eeo pipefail
    trap 'sigpi_build_failed "${BASH_SOURCE[0]}" "$1" "$LINENO" "$?"' ERR
fi

case "$1" in 
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : FFTW"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&

    remove )
        rm $SIGPI_ETC/fftw-wisdom
        sed -i /fftw/d $SIGPI_INSTALLED
        ;;&

    purge )
        rm $SIGPI_ETC/fftw-wisdom
        sed -i /fftw/d $SIGPI_INSTALLED
        ;;&

    install )
        ## DEPENDENCIES
        sudo apt-get install -y libfftw3-dev
        sudo apt-get install -y libboost-all-dev
        sudo apt-get install -y libgl1-mesa-dev 
        sudo apt-get install -y libopencv-dev
        sudo apt-get install -y libxml2-dev
        sudo apt-get install -y bison
        sudo apt-get install -y flex
        sudo apt-get install -y ffmpeg
        sudo apt-get install -y opus-tools
        sudo apt-get install -y libopus-dev
        sudo apt-get install -y libgl1-mesa-glx

        ## PACKAGE
        # Use an existing wisdom file if one is already present. Otherwise generate a new
        # one for FFT sizes : 128, 256, 512, 1024, 2048, 4096, 8192, 16384 and 32768.
        # Generating is optional and will take a very long time.
        if [ -s "$SIGPI_ETC/fftw-wisdom" ]; then
            echo -e "${SIGPI_BANNER_COLOR} ##  Existing FFTW wisdom file found at $SIGPI_ETC/fftw-wisdom - using it"
            echo -e "${SIGPI_BANNER_RESET}"
        else
            fftwf-wisdom -v -n -o $SIGPI_ETC/fftw-wisdom 128 256 512 1024 2048 4096 8192 16384 32768
        fi
        cat $SIGPI_PKGLIST|grep "fftw" >> $SIGPI_INSTALLED

	    ## DESKTOP
        # Add Icon      
        # Add Desktop
        # Add Run script
        # Change Category
        # Add to Menu
        ;;&
    
    build )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##   Build option not available"
        echo -e "${SIGPI_BANNER_RESET}"
	    ;;&

    package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##   Package option not available"
        echo -e "${SIGPI_BANNER_RESET}"
	    ;;&

    remove|purge|install )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : FFTW - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac
