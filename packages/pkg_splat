#!/bin/bash

###
### SIGPI
###
### pkg_splat
###
###
### 20260113-2300
###
### SPLAT - Sound Pressure Level Analysis Tool
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGPI_BANNER_COLOR}"
    echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGPI_BANNER_RESET}"
    exit 1
fi

case "$1" in 
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : SPLAT"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&

    remove )
        sudo apt-get remove splat
        sed -i /splat/d $SIGPI_INSTALLED
        ### Remove Menu icon
        sudo rm $SIGPI_DESKTOP_ICONS/splat.png
        ### Remove Desktop links
        sudo rm $SIGPI_DESKTOP_FILES/splat.desktop
        ;;&

    purge )
        sudo apt-get remove --purge splat
        sed -i /splat/d $SIGPI_INSTALLED
        ### Remove Menu icon
        sudo rm $SIGPI_DESKTOP_ICONS/splat.png
        ### Remove Desktop links
        sudo rm $SIGPI_DESKTOP_FILES/splat.desktop
        ;;&

    install )
        ## DEPENDENCIES

        ## PACKAGE
        cd $SIGPI_SOURCE
        sudo apt-get install -y splat
        cat $SIGPI_PKGLIST|grep "splat" >> $SIGPI_INSTALLED 

        ## DESKTOP
	    # Add Icon
        sudo cp $SIGPI_ICONS/splat.png $DESKTOP_ICONS
        # Add Desktop
        sudo cp $SIGPI_HOME/desktop/splat.desktop $DESKTOP_FILES
	    # Change Category
        # Add to Menu
        xdg-desktop-menu install --novendor --noupdate $DESKTOP_DIRECTORY/SIGpi.directory $DESKTOP_FILES/splat.desktop
        ;;&

    build )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##   Build option not available"
        echo -e "${SIGPI_BANNER_RESET}"
	    ;;&

    package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##   Package option not available"
        echo -e "${SIGPI_BANNER_RESET}"
	    ;;&

    remove|purge|install )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : SigUtils - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac
