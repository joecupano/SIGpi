#!/bin/bash

###
### SIGPI
###
### pkg_gpredict
###
###
### 20260910-0100
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGPI_BANNER_COLOR}"
    echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGPI_BANNER_RESET}"
    exit 1
fi

case "$1" in
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : Gpredict"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&

    remove )
        sudo apt-get remove gpredict
        sed -i /gpredict/d $SIGPI_INSTALLED
        ;;&

    purge )
        sudo apt-get remove --purge gpredict
        sed -i /gpredict/d $SIGPI_INSTALLED
        rm -rf $HOME/.config/Gpredict
        sudo rm -rf $SIGPI_DESKTOP/gpredict.desktop
        sudo rm -rf $DESKTOP_FILES/gpredict.desktop
        ;;&

    install|build|package )
        ## DEPENDENCIES
        sudo apt-get install -y libtool intltool autoconf automake 
        sudo apt-get install -y libcurl4-openssl-dev
        sudo apt-get install -y pkg-config libglib2.0-dev libgtk-3-dev
        sudo apt-get install -y libgoocanvas-2.0-dev
        ;;&

    install )
        ## PACKAGE
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i gpredict_current_amd64.deb
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i gpredict_current_arm64.deb
        fi
        cat $SIGPI_PKGLIST|grep "gpredict" >> $SIGPI_INSTALLED

        ## DESKTOP
	    # Add Icon
        # Add Desktop
        # Change Category
	    #sudo sed -i "s/Categories.*/Categories=$SIGPI_MENU_CATEGORY;/" $DESKTOP_FILES/gpredict.desktop
        # Add to Menu
        #xdg-desktop-menu install --novendor --noupdate $DESKTOP_DIRECTORY/SIGpi.directory $DESKTOP_FILES/gpredict.desktop
        ;;&

    build )
        cd $SIGPI_SOURCE
        git clone https://github.com/csete/gpredict.git
        cd gpredict
        git checkout v2.6 # v2.6
        ./autogen.sh
        make -j4
        sudo make install
        cat $SIGPI_PKGLIST|grep "gpredict" >> $SIGPI_INSTALLED
	    ;;&

    package )
        cd $SIGPI_SOURCE
        git clone https://github.com/csete/gpredict.git
        cd gpredict
        git checkout v2.6 # v2.6
        ./autogen.sh
        make -j4
        rm -rf pkgroot && mkdir -p pkgroot
        make DESTDIR="$(pwd)/pkgroot" install
        sigpi_stage_package "gpredict" "2.6" "$(pwd)/pkgroot" "Real-time satellite tracking and orbit prediction application"
        rm -rf pkgroot
        ;;&

    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : Gpredict - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac
