#!/bin/bash

###
### SIGPI
###
### pkg_gpredict
###
###
### 20260113-2300
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGPI_BANNER_COLOR}"
    echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGPI_BANNER_RESET}"
    exit 1
fi

case "$1" in
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : Gpredict"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&

    remove )
        sudo apt-get remove gpredict
        sed -i /gpredict/d $SIGPI_INSTALLED
        ;;&

    purge )
        sudo apt-get remove --purge gpredict
        sed -i /gpredict/d $SIGPI_INSTALLED
        rm -rf $HOME/.config/Gpredict
        sudo rm -rf $SIGPI_DESKTOP/gpredict.desktop
        sudo rm -rf $DESKTOP_FILES/gpredict.desktop
        ;;&

    install )
        ## DEPENDENCIES
        sudo apt-get install -y intltool
        sudo apt-get install -y libcurl4-openssl-dev
        sudo apt-get install -y libgoocanvas-2.0-dev

        ## PACKAGE
        cd $SIGPI_SOURCE
        sudo apt-get install -y gpredict
        cat $SIGPI_PKGLIST|grep "gpredict" >> $SIGPI_INSTALLED 

        ## DESKTOP
	    # Add Icon
        # Add Desktop
        # Change Category
	    sudo sed -i "s/Categories.*/Categories=$SIGPI_MENU_CATEGORY;/" $DESKTOP_FILES/gpredict.desktop
        # Add to Menu
        xdg-desktop-menu install --novendor --noupdate $DESKTOP_DIRECTORY/SIGpi.directory $DESKTOP_FILES/gpredict.desktop

        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##   Gpredict Installed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&

    build )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##   Build option not available"
        echo -e "${SIGPI_BANNER_RESET}"
	    ;;&

    package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##   Package option not available"
        echo -e "${SIGPI_BANNER_RESET}"
	    ;;&

    remove|purge|install )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : Gpredict - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac
