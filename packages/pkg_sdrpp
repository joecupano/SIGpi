###
### SDR++ Package Management Script
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGPI_BANNER_COLOR}"
    echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGPI_BANNER_RESET}"
    exit 1
fi

case "$1" in 
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : SDR++"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&

    remove )
        sudo dpkg -r sdrpp
        sed -i /sdrpp/d $SIGPI_INSTALLED
        ;;&

    purge )
        sudo dpkg -P sdrpp
        sed -i /sdrpp/d $SIGPI_INSTALLED
   
        sudo rm -rf $SIGPI_DESKTOP/sdrpp.desktop
        sudo rm -rf $DESKTOP_FILES/sdrpp.desktop
        ;;&

    install|build|package )
        ## DEPENDENCIES
        sudo apt-get install -y libglew-dev
        sudo apt-get install -y libglfw3-dev
        sudo apt-get install -y libsoapysdr-dev
        sudo apt-get install -y libad9361-dev 
        sudo apt-get install -y libairspyhf-dev 
        sudo apt-get install -y librtaudio-dev
        sudo apt-get install -y libcodec2-dev
        sudo apt-get install -y libvolk2-bin libvolk2-dev
        sudo apt-get install -y libzstd-dev
        ;;&

    install )
        ## PACKAGE
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i sdrpp_current_amd64.deb
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i sdrpp_current_arm64.deb
        fi
        cat $SIGPI_PKGLIST|grep "sdrpp" >> $SIGPI_INSTALLED 
        
	    ## DESKTOP
	    # Add Icon
        # Add Desktop
        # Change Category
	    #sudo sed -i "s/Categories.*/Categories=$SIGPI_MENU_CATEGORY;/" $DESKTOP_FILES/sdrpp.desktop
        # Add to Menu
        #xdg-desktop-menu install --novendor --noupdate $DESKTOP_DIRECTORY/SIGpi.directory $DESKTOP_FILES/sdrpp.desktop
        ;;&

    build )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##   Build option not available"
        echo -e "${SIGPI_BANNER_RESET}"
	    ;;&

    package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##   Package option not available"
        echo -e "${SIGPI_BANNER_RESET}"
	    ;;&

    remove|purge|install )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : SDR++ - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac
