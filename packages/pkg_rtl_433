#!/bin/bash

###
### SIGPI
###
### pkg_rtl_433
###
###
### 20260910-0100
###
### RTL_433 - RTL-SDR based 433.92MHz ISM band signal decoder
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGPI_BANNER_COLOR}"
    echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGPI_BANNER_RESET}"
    exit 1
fi

# Fail fast on build errors: a failed compile/install step must not result
# in a broken .deb being staged or the package being marked installed.
# See sigpi_build_failed() in SIGpi_pkgbuild.
if [[ "$1" =~ ^(install|build|package)$ ]]; then
    set -Eeo pipefail
    trap 'sigpi_build_failed "${BASH_SOURCE[0]}" "$1" "$LINENO" "$?"' ERR
fi

case "$1" in 
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : rtl_433"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&

    remove )
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
            sudo dpkg -r rtl_433
            sed -i /rtl_433/d $SIGPI_INSTALLED
            sudo rm $DESKTOP_ICONS/rtl_433.png
            sudo rm $DESKTOP_FILES/rtl_433.desktop
            sudo rm $DESKTOP_FILES/rtl_adsb.desktop
            sudo rm $DESKTOP_FILES/rtl_fm.desktop
            sudo rm $DESKTOP_FILES/rtl_test.desktop
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
            sudo dpkg -r rtl_433
            sed -i /rtl_433/d $SIGPI_INSTALLED
            sudo rm $DESKTOP_ICONS/rtl_433.png
            sudo rm $DESKTOP_FILES/rtl_433.desktop
            sudo rm $DESKTOP_FILES/rtl_adsb.desktop
            sudo rm $DESKTOP_FILES/rtl_fm.desktop
            sudo rm $DESKTOP_FILES/rtl_test.desktop
        fi
        ;;&

    purge )
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
            sudo dpkg -P rtl_433
            sed -i /rtl_433/d $SIGPI_INSTALLED
            sudo rm $DESKTOP_ICONS/rtl_433.png
            sudo rm $DESKTOP_FILES/rtl_433.desktop
            sudo rm $DESKTOP_FILES/rtl_adsb.desktop
            sudo rm $DESKTOP_FILES/rtl_fm.desktop
            sudo rm $DESKTOP_FILES/rtl_test.desktop
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
            sudo dpkg -P rtl_433
            sed -i /rtl_433/d $SIGPI_INSTALLED
            sudo rm $DESKTOP_ICONS/rtl_433.png
            sudo rm $DESKTOP_FILES/rtl_433.desktop
            sudo rm $DESKTOP_FILES/rtl_adsb.desktop
            sudo rm $DESKTOP_FILES/rtl_fm.desktop
            sudo rm $DESKTOP_FILES/rtl_test.desktop
        fi
        ;;&

    install)
        ## PACKAGE
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i rtl_433_current_amd64.deb
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i rtl_433_current_arm64.deb
        fi
        cat $SIGPI_PKGLIST|grep "rtl_433" >> $SIGPI_INSTALLED

	    ## DESKTOP
	    # Add Icon
        # Add Desktop
        sudo cp $SIGPI_DESKTOP/rtl_433.desktop $DESKTOP_FILES
        sudo cp $SIGPI_DESKTOP/rtl_adsb.desktop $DESKTOP_FILES
        sudo cp $SIGPI_DESKTOP/rtl_fm.desktop $DESKTOP_FILES
        sudo cp $SIGPI_DESKTOP/rtl_test.desktop $DESKTOP_FILES 
        # Change Category
	    # Add to Menu
        ;;&

    build )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##   Build option not available"
        echo -e "${SIGPI_BANNER_RESET}"
	    ;;&

    package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##   Package option not available"
        echo -e "${SIGPI_BANNER_RESET}"
	    ;;&

    remove|purge|install )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : rtl_433 - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
    ;;
esac
