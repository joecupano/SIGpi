#!/bin/bash

###
### SIGpi
###
### pkg_mbelib
###
###
### 20240113-2300
###
### mbelib supports the 7200x4400 bit/s codec used in P25 Phase 1, the 7100x4400 bit/s codec used in
### ProVoice and the "Half Rate 3600x2250 bit/s vocoder used in various radio systems.
###

case "$1" in 
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : mbelib (P25 Phase)"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&

    remove )
        cd $SIGPI_SOURCE/mbelib/build
        sudo make uninstall
        sudo ldconfig
        rm -rf $SIGPI_SOURCE/mbe
        sed -i /mbelib/d $SIGPI_INSTALLED
        ;;&

    purge )
        cd $SIGPI_SOURCE/mbelib/build
        sudo make uninstall
        sudo ldconfig
        rm -rf $SIGPI_SOURCE/mbe
        sed -i /mbelib/d $SIGPI_INSTALLED
        ;;&

    install|build )
        ## DEPENDENCIES

        ## PACKAGE
        cd $SIGPI_SOURCE
        git clone https://github.com/szechyjs/mbelib.git
        cd mbelib
        git reset --hard 9a04ed5c78176a9965f3d43f7aa1b1f5330e771f
        mkdir build; cd build
        cmake -Wno-dev ..
        make -j4
        sudo make install
        sudo ldconfig
        cat $SIGPI_PKGLIST|grep "mbeliib" >> $SIGPI_INSTALLED 

        ## DESKTOP
	    # Add Icon
        # Add Desktop
        # Change Category
	    # Add to Menu
        ;;&

    package )
        ## DEPENDENCIES

        ## PACKAGE
        cd $SIGPI_SOURCE
        git clone https://github.com/szechyjs/mbelib.git
        cd mbelib
        mkdir build; cd build
        cmake -Wno-dev ..
        make -j4
        sudo checkinstall --install=no
        sudo mv *.deb $SIGPI_DEBS

        ## DESKTOP
	    # Add Icon
        # Add Desktop
        # Change Category
	    # Add to Menu
        ;;&

    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : mbelib (P25 Phase) - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&

    * )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unkown action or package"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac
