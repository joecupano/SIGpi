#!/bin/bash

###
### SIGpi
###
### pkg_mbelib
###
###
### 20260910-0100
###
### mbelib supports the 7200x4400 bit/s codec used in P25 Phase 1, the 7100x4400 bit/s codec used in
### ProVoice and the "Half Rate 3600x2250 bit/s vocoder used in various radio systems.
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGPI_BANNER_COLOR}"
    echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGPI_BANNER_RESET}"
    exit 1
fi

case "$1" in 
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : mbelib (P25 Phase)"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&
    remove )
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
            sudo dpkg -r mbelib
            sed -i /mbelib/d $SIGPI_INSTALLED
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
            sudo dpkg -r mbelib
            sed -i /mbelib/d $SIGPI_INSTALLED
        fi
        ;;&

    purge )
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
            sudo dpkg -P mbelib
            sed -i /mbelib/d $SIGPI_INSTALLED
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
            sudo dpkg -P mbelib
            sed -i /mbelib/d $SIGPI_INSTALLED
        fi
        ;;&

    install)
        ## PACKAGE
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i mbelib_current_amd64.deb
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i mbelib_current_arm64.deb
        fi
        cat $SIGPI_PKGLIST|grep "mbelib" >> $SIGPI_INSTALLED

	    ## DESKTOP
	    # Add Icon
        # Add Desktop
        # Change Category
	    # Add to Menu
        ;;&

    build )
        ## DEPENDENCIES

        ## PACKAGE
        cd $SIGPI_SOURCE
        git clone https://github.com/szechyjs/mbelib.git
        cd mbelib
        git reset --hard e2d84c1 # v1.3.0
        mkdir build; cd build
        cmake -Wno-dev ..
        make -j4
        sudo make install
        sudo ldconfig
        cat $SIGPI_PKGLIST|grep "mbeliib" >> $SIGPI_INSTALLED 

        ## DESKTOP
	    # Add Icon
        # Add Desktop
        # Change Category
	    # Add to Menu
        ;;&

    package )
        ## DEPENDENCIES

        ## PACKAGE
        cd $SIGPI_SOURCE
        git clone https://github.com/szechyjs/mbelib.git
        cd mbelib
        git reset --hard e2d84c1 # v1.3.0
        mkdir build; cd build
        cmake -Wno-dev ..
        make -j4
        rm -rf pkgroot && mkdir -p pkgroot
        make DESTDIR="$(pwd)/pkgroot" install
        sigpi_stage_package "mbelib" "1.3.0" "$(pwd)/pkgroot" "P25 Phase 1 and ProVoice vocoder"
        rm -rf pkgroot

        ## DESKTOP
	    # Add Icon
        # Add Desktop
        # Change Category
	    # Add to Menu
        ;;&

    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : mbelib (P25 Phase) - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac
