#!/bin/bash

###
### SIGPI
###
### pkg_nrsc5
###
###
### 20260910-0100
###
### This program receives NRSC-5 digital radio stations using an RTL-SDR dongle. It offers
### a command-line interface as well as an API upon which other applications can be built.
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGPI_BANNER_COLOR}"
    echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGPI_BANNER_RESET}"
    exit 1
fi

# Fail fast on build errors: a failed compile/install step must not result
# in a broken .deb being staged or the package being marked installed.
# See sigpi_build_failed() in SIGpi_pkgbuild.
if [[ "$1" =~ ^(install|build|package)$ ]]; then
    set -Eeo pipefail
    trap 'sigpi_build_failed "${BASH_SOURCE[0]}" "$1" "$LINENO" "$?"' ERR
fi

case "$1" in 
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : NRSC5 (HD Radio)"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&

    remove )
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
            sudo dpkg -r nrsc5
            sed -i /nrsc5/d $SIGPI_INSTALLED
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
            sudo dpkg -r nrsc5
            sed -i /nrsc5/d $SIGPI_INSTALLED
        fi
        ;;&

    purge )
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
            sudo dpkg -P nrsc5
            sed -i /nrsc5/d $SIGPI_INSTALLED
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
            sudo dpkg -P nrsc5
            sed -i /nrsc5/d $SIGPI_INSTALLED
        fi
        ;;&

    install|build|package )
        ## DEPENDENCIES
        sudo apt install -y libao-dev libfftw3-dev librtlsdr-dev
        ;;&

    install)
        ## PACKAGE
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i nrsc5_current_amd64.deb
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i nrsc5_current_arm64.deb
        fi
        cat $SIGPI_PKGLIST|grep "nrsc5" >> $SIGPI_INSTALLED

	    ## DESKTOP
	    # Add Icon
        # Add Desktop
        # Change Category
	    # Add to Menu
        ;;&

    build )
        ## PACKAGE
        cd $SIGPI_SOURCE
        git clone https://github.com/theori-io/nrsc5.git
        cd nrsc5
        git checkout v3.2.0 # v3.2.0
        mkdir build && cd build
        cmake .. -Wno-dev
        make -j4
        sudo make install
        sudo ldconfig
        cat $SIGPI_PKGLIST|grep "nrsc5" >> $SIGPI_INSTALLED

        ## DESKTOP
        # Add Icon
        # Add Desktop
        sudo cp $SIGPI_HOME/desktop/nrsc5.desktop $DESKTOP_FILES
        # Change Category
        # Add to Menu
        xdg-desktop-menu install --novendor --noupdate $DESKTOP_DIRECTORY/SIGpishell.directory $DESKTOP_FILES/nrsc5.desktop
        ;;&

    package )
        ## PACKAGE
        cd $SIGPI_SOURCE
        git clone https://github.com/theori-io/nrsc5.git
        cd nrsc5
        git checkout v3.2.0 # v3.2.0
        mkdir build && cd build
        cmake .. -Wno-dev
        make -j4
        rm -rf pkgroot && mkdir -p pkgroot
        make DESTDIR="$(pwd)/pkgroot" install
        sigpi_stage_package "nrsc5" "3.2.0" "$(pwd)/pkgroot" "Receives NRSC-5 digital radio stations using an RTL-SDR dongle"
        rm -rf pkgroot

        ## DESKTOP
	    # Add Icon
        # Add Desktop
        # Change Category
	    # Add to Menu
        ;;&

    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : NRSC5 (HD Radio) - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac
