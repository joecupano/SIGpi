#!/bin/bash

###
### SIGpi
###
### pkg_plutosdr
###
###
### 20260110-2300
###
### PlutoSDR
###

case "$1" in 
    install|build|package|remove|purge )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##   $1 :  PlutoSDR and SoapyPlutoSDR"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&
    install|build|package )

        ## DEPENDENCIES
        sudo apt-get install -y libaio-dev libusb-1.0-0-dev 
        sudo apt-get install -y libserialport-dev libavahi-client-dev 
        sudo apt-get install -y libxml2-dev bison flex libcdk5-dev 
        sudo apt-get install -y python3 python3-pip python3-setuptools

        # INSTALL
        cd $SIGPI_SOURCE
        git clone https://github.com/analogdevicesinc/libiio.git
        cd libiio
        #20230924  need to chekcout v0.25 so SoapPlutoSDR works
        git checkout v0.25
        mkdir build && cd build
        #20230830 Compile error not finding ZSTD though installed. So disable for now
        cmake .. -Wno-dev -WITH_ZSTD=OFF
        make -j4
        
        # SoapyPlutoSDR
        sudo apt-get install -y libserialport-dev libavahi-client-dev 
        cd $SIGPI_SOURCE
        git clone https://github.com/pothosware/SoapyPlutoSDR.git
        cd SoapyPlutoSDR
        mkdir build && cd build
        cmake .. -Wno-dev
        make -j4
        ;;&
    
    install )
        cd $SIGPI_SOURCE/libiio/build
        sudo make install
        sudo ldconfig
        
        cd $SIGPI_SOURCE/SoapyPlutoSDR/build
        sudo make install
        sudo ldconfig
        cat $SIGPI_PKG_LIST|grep "plutosdr" >> $SIGPI_INSTALLED
        ;;&

    build|package )
        cd $SIGPI_SOURCE/libiio/build
        sudo checkinstall
        sudo mv *.deb $SIGPI_DEBS
        
        cd $SIGPI_SOURCE/SoapyPlutoSDR/build
        sudo checkinstall
        sudo mv *.deb $SIGPI_DEBS
        ;;&

    package )
        cd $SIGPI_SOURCE/libiio/build
        sudo checkinstall --install=no
        sudo mv *.deb $SIGPI_DEBS
        
        cd $SIGPI_SOURCE/SoapyPlutoSDR/build
        sudo checkinstall --install=no
        sudo mv *.deb $SIGPI_DEBS
        ;;&

    remove|purge )
        sudo dpkg -P libiio
        sudo dpkg -P SoapyPlutoSDR
        sed -i /libiio/d $SIGPI_INSTALLED
        ;;&
    
    install|build|package|remove|purge )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##   $1 :  PlutoSDR and SoapyPlutoSDR Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&
    
    * )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unkown action or package"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac