#!/bin/bash

###
### SIGPI
###
### pkg_xastir
###
###
### 20260910-0100
###
### Xastir Package Script
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGPI_BANNER_COLOR}"
    echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGPI_BANNER_RESET}"
    exit 1
fi

# Fail fast on build errors: a failed compile/install step must not result
# in a broken .deb being staged or the package being marked installed.
# See sigpi_build_failed() in SIGpi_pkgbuild.
if [[ "$1" =~ ^(install|build|package)$ ]]; then
    set -Eeo pipefail
    trap 'sigpi_build_failed "${BASH_SOURCE[0]}" "$1" "$LINENO" "$?"' ERR
fi

case "$1" in 
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : Xastir"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&

    remove )
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
            sudo dpkg -r xastir
            sed -i /xastir/d $SIGPI_INSTALLED
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
            sudo dpkg -r xastir
            sed -i /xastir/d $SIGPI_INSTALLED
        fi
        ;;&

    purge )
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
            sudo dpkg -P xastir
            sed -i /xastir/d $SIGPI_INSTALLED
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
            sudo dpkg -P xastir
            sed -i /xastir/d $SIGPI_INSTALLED
        fi
        ;;&
    
    install|build|package )
        sudo apt update
        sudo apt install -y build-essential git autoconf automake \
        libmotif-dev libxext-dev libxpm-dev libxt-dev \
        libcurl4-openssl-dev shapelib libshp-dev \
        libgeotiff-dev libpcre3-dev libdb-dev \
        graphicsmagick libgraphicsmagick1-dev \
        gv festival festival-dev
        ;;&
        
    install)
        ## PACKAGE
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i xastir_current_amd64.deb
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i xastir_current_arm64.deb
        fi
        cat $SIGPI_PKGLIST|grep "xastir" >> $SIGPI_INSTALLED

	    ## DESKTOP
	    # Add Icon
        # Add Desktop
        # Change Category
	    # Add to Menu
        ;;&

    build )
        cd $SIGPI_SOURCE
        git clone https://github.com/Xastir/Xastir.git
        cd Xastir
        git checkout Release-2.2.4 # v2.2.4
        ./bootstrap.sh
        mkdir build && cd build
        ../configure
        make -j4
        sudo make install
        cat $SIGPI_PKGLIST|grep "xastir" >> $SIGPI_INSTALLED
        
        ## DESKTOP
	    # Add Icon
        # Add Desktop
        # Change Category
	    sudo sed -i "s/Categories.*/Categories=$SIGPI_MENU_CATEGORY;/" $DESKTOP_FILES/xastir.desktop
        # Add to Menu
        xdg-desktop-menu install --novendor --noupdate $DESKTOP_DIRECTORY/SIGpi.directory $DESKTOP_FILES/xastir.desktop
        ;;&

    package )
        cd $SIGPI_SOURCE
        git clone https://github.com/Xastir/Xastir.git
        cd Xastir
        git checkout Release-2.2.4 # v2.2.4
        ./bootstrap.sh
        mkdir build && cd build
        ../configure
        make -j4
        rm -rf pkgroot && mkdir -p pkgroot
        make DESTDIR="$(pwd)/pkgroot" install
        sigpi_stage_package "xastir" "2.2.4" "$(pwd)/pkgroot" "APRS client program with positional data in a graphical application"
        rm -rf pkgroot
	    ;;&

    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : Xastir - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac
