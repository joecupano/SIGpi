#!/bin/bash

###
### SIGPI
###
### pkg_multimon-ng
###
###
### 20260113-2300
###
### Multimon-NG is a decoder for various digital transmission protocols
### including POCSAG, FSK, AFSK, DTMF, and X10.
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGPI_BANNER_COLOR}"
    echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGPI_BANNER_RESET}"
    exit 1
fi

case "$1" in 
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : Multimon-NG"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&
    remove )
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
            sudo dpkg -r multimon-ng
            sed -i /multimon-ng/d $SIGPI_INSTALLED
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
            sudo dpkg -r multimon-ng
            sed -i /multimon-ng/d $SIGPI_INSTALLED
        fi
        ;;&

    purge )
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
            sudo dpkg -P multimon-ng
            sed -i /multimon-ng/d $SIGPI_INSTALLED
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
            sudo dpkg -P multimon-ng
            sed -i /multimon-ng/d $SIGPI_INSTALLED
        fi
        ;;&

    install)
        ## PACKAGE
        cd $SIGPI_PACKAGES        
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i multimon-ng_current_amd64.deb
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        cd $SIGPI_DEBS
	        sudo dpkg -i multimon-ng_current_arm64.deb
        fi
        cat $SIGPI_PKGLIST|grep "multimon-ng" >> $SIGPI_INSTALLED

	    ## DESKTOP
	    # Add Icon
        # Add Desktop
        # Change Category
	    # Add to Menu
        ;;&

    build )
        ## DEPENDENCIES

        ## PACKAGE
        cd $SIGPI_SOURCE
        git clone https://github.com/EliasOenal/multimon-ng.git
        cd multimon-ng
        mkdir build && cd build
        cmake .. -Wno-dev
        make -j4
        sudo make install
        sudo ldconfig
        cat $SIGPI_PKGLIST|grep "multimon-ng" >> $SIGPI_INSTALLED 
        
        ## DESKTOP
        # Add Icon
        # Add Desktop
        sudo cp $SIGPI_HOME/desktop/multimon-ng.desktop $DESKTOP_FILES
        # Change Category
        # Add to Menu
        xdg-desktop-menu install --novendor --noupdate $DESKTOP_DIRECTORY/SIGpishell.directory $DESKTOP_FILES/multimon-ng.desktop
        ;;&

    package )
        ## DEPENDENCIES

        ## PACKAGE
        cd $SIGPI_SOURCE
        git clone https://github.com/EliasOenal/multimon-ng.git
        cd multimon-ng
        mkdir build && cd build
        cmake .. -Wno-dev
        make -j4
        sudo checkinstall --install=no
        sudo mv *.deb $SIGPI_DEBS
        
        ## DESKTOP
	    # Add Icon
        # Add Desktop
        # Change Category
	    # Add to Menu
        ;;&
        
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : Multimon-NG - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac
