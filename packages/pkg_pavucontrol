#!/bin/bash

###
### SIGPI
###
### pkg_pavucontrol
###
###
### 20260910-0100
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGPI_BANNER_COLOR}"
    echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGPI_BANNER_RESET}"
    exit 1
fi

# Fail fast on build errors: a failed compile/install step must not result
# in a broken .deb being staged or the package being marked installed.
# See sigpi_build_failed() in SIGpi_pkgbuild.
if [[ "$1" =~ ^(install|build|package)$ ]]; then
    set -Eeo pipefail
    trap 'sigpi_build_failed "${BASH_SOURCE[0]}" "$1" "$LINENO" "$?"' ERR
fi

case "$1" in 
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : PAVUcontrol"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&

    remove )
        sudo apt-get remove pavucontrol
        sudo apt-get remove paprefs
        sed -i /pavu/d $SIGPI_INSTALLED
        ;;&

    purge )
        sudo apt-get remove --purge pavucontrol
        sudo apt-get remove --purge paprefs
        sed -i /pavu/d $SIGPI_INSTALLED
        ;;&

    install )
        ## DEPENDENCIES

        ## PACKAGE
        cd $SIGPI_SOURCE
        sudo apt-get install -y pavucontrol
        echo " " >> /etc/pulse/default.pa
        echo "## SIGpi adding Virtual Audio Sink " >> /etc/pulse/default.pa
        echo "load-module module-null-sink sink_name=Virtual_Sink sink_properties=device.description=Virtual_Sink" >> /etc/pulse/default.pa
	    sudo apt-get install -y paprefs
        cat $SIGPI_PKGLIST|grep "pavucontrol" >> $SIGPI_INSTALLED 

        ## DESKTOP
	    # Add Icon
        # Add Desktop
        # Change Category
        # Add to menu
        ;;&

    build )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##   Build option not available"
        echo -e "${SIGPI_BANNER_RESET}"
	    ;;
    
    package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##   Package option not available"
        echo -e "${SIGPI_BANNER_RESET}"
	    ;;

    remove|purge|install )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : PAVUcontrol - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac
