#!/bin/bash

###
### SIGPI
###
### pkg_srsran-4g
###
###
### 20260910-0100
###
### Verified arm64: build is a plain cmake/make flow with no arch-specific flags, and
### upstream documents building srsRAN 4G the same way on Raspberry Pi 4/5 (aarch64) as
### on x86_64. release_25_10 (v25.10) is current upstream stable for both architectures.
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGPI_BANNER_COLOR}"
    echo -e "${SIGPI_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGPI_BANNER_RESET}"
    exit 1
fi

case "$1" in 
    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : srsRAN-4g"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;&

    remove )
        sudo dpkg -r srsran-4g
        sed -i /srsran-4g/d $SIGPI_INSTALLED
        ;;&

    purge )
        sudo dpkg -P srsran-4g
        sed -i /srsran-4g/d $SIGPI_INSTALLED
        ;;&

    install )
        ## DEPENDENCIES
        sudo apt-get install -y libmbedtls-dev libboost-program-options-dev
        sudo apt-get install -y libconfig++-dev libsctp-dev

        ## PACKAGE
        cd $SIGPI_DEBS       
        if [[ "$SIGPI_HWARCH" == "x86_64" ]]; then
	        sudo dpkg -i srsran-4g_current_amd64.deb
            cat $SIGPI_PKGLIST|grep "srsran-4g" >> $SIGPI_INSTALLED
        fi

        if [[ "$SIGPI_HWARCH" == "aarch64" ]]; then
	        sudo dpkg -i srsran-4g_current_arm64.deb
            cat $SIGPI_PKGLIST|grep "srsran-4g" >> $SIGPI_INSTALLED
        fi
	    ;;&

    build )
        ## DEPENDENCIES
        sudo apt-get install -y libmbedtls-dev libboost-program-options-dev
        sudo apt-get install -y libconfig++-dev libsctp-dev
        cd $SIGPI_SOURCE
        git clone https://github.com/srsRAN/srsRAN_4G.git
        cd srsRAN_4G
        git checkout release_25_10 # v25.10
        mkdir build ; cd build
        cmake ../
        make -j4
        sudo make install
        cat $SIGPI_PKGLIST|grep "srsran-4g" >> $SIGPI_INSTALLED
        ;;&
    
    package )
        ## DEPENDENCIES
        sudo apt-get install -y libmbedtls-dev libboost-program-options-dev
        sudo apt-get install -y libconfig++-dev libsctp-dev
        cd $SIGPI_SOURCE
        git clone https://github.com/srsRAN/srsRAN_4G.git
        cd srsRAN_4G
        git checkout release_25_10 # v25.10
        mkdir build ; cd build
        cmake ../
        make -j4
        rm -rf pkgroot && mkdir -p pkgroot
        make DESTDIR="$(pwd)/pkgroot" install
        sigpi_stage_package "srsran-4g" "25.10" "$(pwd)/pkgroot" "end-to-end 4G network implementation with full-stack applications"
        rm -rf pkgroot
	    ;;&

    remove|purge|install|build|package )
        echo -e "${SIGPI_BANNER_COLOR}"
        echo -e "${SIGPI_BANNER_COLOR} ##  $1 : srsRAN-4g - Completed"
        echo -e "${SIGPI_BANNER_RESET}"
        ;;
esac
