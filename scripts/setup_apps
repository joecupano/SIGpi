#!/bin/bash

###
### SIGPI Package Installation Menu
###
### Interactive whiptail menu for selecting and installing packages
###


###
### INIT VARIABLES AND DIRECTORIES
###

# SIGpi Directory tree
SIGPI_ROOT=$HOME/SIG
SIGPI_SOURCE=$SIGPI_ROOT/source
SIGPI_HOME=$SIGPI_ROOT/SIGpi
SIGPI_ETC=$SIGPI_ROOT/etc
SIGPI_DEVICES=$SIGPI_HOME/devices
SIGPI_SCRIPTS=$SIGPI_HOME/scripts
SIGPI_PACKAGES=$SIGPI_HOME/packages
SIGPI_DEBS=$SIGPI_HOME/debs

# SIGpi Install Support files
SIGPI_INSTALLED=$SIGPI_ETC/INSTALLED_PKGS
SIGPI_PKGLIST=$SIGPI_PACKAGES/PACKAGES
SIGPI_INSTALLED_DEVICES=$SIGPI_ETC/INSTALLED_DEVICES
SIGPI_DEVLIST=$SIGPI_DEVICES/DEVICES
SIGPI_SCREEN_STANDARD=$SIGPI_SCRIPTS/screen_standard_setup
SIGPI_SCREEN_SERVER=$SIGPI_SCRIPTS/screen_server_setup
SIGPI_BANNER_COLOR="\e[0;104m\e[K"   # blue
SIGPI_BANNER_RESET="\e[0m"

# Desktop Source directories
SIGPI_BACKGROUNDS=$SIGPI_HOME/backgrounds
SIGPI_ICONS=$SIGPI_HOME/icons
SIGPI_LOGO=$SIGPI_HOME/logo
SIGPI_DESKTOP=$SIGPI_HOME/desktop

# Desktop Destination Directories
DESKTOP_DIRECTORY=/usr/share/desktop-directories
DESKTOP_FILES=/usr/share/applications
DESKTOP_ICONS=/usr/share/icons
DESKTOP_XDG_MENU=/usr/share/extra-xdg-menus

# SIGpi Menu category
SIGPI_MENU_CATEGORY=SIGpi
HAMRADIO_MENU_CATEGORY=HamRadio

# Export environment variables so package scripts can access them
export SIGPI_ROOT SIGPI_SOURCE SIGPI_HOME SIGPI_ETC SIGPI_DEVICES SIGPI_SCRIPTS SIGPI_PACKAGES SIGPI_DEBS
export SIGPI_INSTALLED SIGPI_PKGLIST SIGPI_INSTALLED_DEVICES SIGPI_DEVLIST
export SIGPI_SCREEN_STANDARD SIGPI_SCREEN_SERVER SIGPI_BANNER_COLOR SIGPI_BANNER_RESET
export SIGPI_BACKGROUNDS SIGPI_ICONS SIGPI_LOGO SIGPI_DESKTOP
export DESKTOP_DIRECTORY DESKTOP_FILES DESKTOP_ICONS DESKTOP_XDG_MENU
export SIGPI_MENU_CATEGORY HAMRADIO_MENU_CATEGORY

# Colors for terminal output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Check if whiptail is installed
if ! command -v whiptail &> /dev/null; then
    echo -e "${RED}Error: whiptail is not installed.${NC}"
    echo "Please install it with: sudo apt-get install whiptail"
    exit 1
fi

# Function to check if a package is installed
is_package_installed() {
    local pkg_name="$1"
    if [ -f "$SIGPI_INSTALLED" ]; then
        grep -q "^$pkg_name," "$SIGPI_INSTALLED" 2>/dev/null
        return $?
    fi
    return 1
}

# Function to read packages and create menu items
build_menu_items() {
    menu_items=()
    local counter=0
    local max_name_length=0
    local pkg_names=()
    
    # First pass: collect all package names and find the longest
    if [ -f "$SIGPI_PKGLIST" ]; then
        while IFS=',' read -r name version description date; do
            [ -z "$name" ] && continue
            if [ -f "$SIGPI_PACKAGES/pkg_$name" ]; then
                pkg_names+=("$name")
                [ ${#name} -gt $max_name_length ] && max_name_length=${#name}
            fi
        done < "$SIGPI_PKGLIST"
    else
        for pkg_file in "$SIGPI_PACKAGES"/pkg_*; do
            [ -f "$pkg_file" ] || continue
            [ "$(basename "$pkg_file")" = "pkg_TEMPLATE" ] && continue
            pkg_name=$(basename "$pkg_file" | sed 's/^pkg_//')
            pkg_names+=("$pkg_name")
            [ ${#pkg_name} -gt $max_name_length ] && max_name_length=${#pkg_name}
        done
    fi
    
    # Second pass: build menu items with aligned symbols
    if [ -f "$SIGPI_PKGLIST" ]; then
        while IFS=',' read -r name version description date; do
            [ -z "$name" ] && continue
            if [ -f "$SIGPI_PACKAGES/pkg_$name" ]; then
                local status_text=""
                if is_package_installed "$name"; then
                    status_text="✓"
                else
                    status_text="○"
                fi
                # Pad the name with spaces for alignment
                local padded_name=$(printf "%-${max_name_length}s" "$name")
                menu_items+=("$padded_name $status_text" "(v$version) $description" "OFF")
                ((counter++))
            fi
        done < "$SIGPI_PKGLIST"
    else
        for pkg_file in "$SIGPI_PACKAGES"/pkg_*; do
            [ -f "$pkg_file" ] || continue
            [ "$(basename "$pkg_file")" = "pkg_TEMPLATE" ] && continue
            pkg_name=$(basename "$pkg_file" | sed 's/^pkg_//')
            description=$(grep -m 1 "^###" "$pkg_file" | tail -n 1 | sed 's/^### //' | sed 's/^##*//')
            [ -z "$description" ] && description="Package: $pkg_name"
            
            local status_text=""
            if is_package_installed "$pkg_name"; then
                status_text="✓"
            else
                status_text="○"
            fi
            # Pad the name with spaces for alignment
            local padded_name=$(printf "%-${max_name_length}s" "$pkg_name")
            menu_items+=("$padded_name $status_text" "$description" "OFF")
            ((counter++))
        done
    fi
    
    if [ $counter -eq 0 ]; then
        echo -e "${RED}Error: No packages found in $SIGPI_PACKAGES${NC}"
        exit 1
    fi
}

# Function to install a package
install_package() {
    local pkg_name="$1"
    local pkg_script="$SIGPI_PACKAGES/pkg_$pkg_name"
    
    echo -e "${YELLOW}Installing $pkg_name...${NC}"
    
    if [ ! -f "$pkg_script" ]; then
        echo -e "${RED}Error: Package script not found: $pkg_script${NC}"
        return 1
    fi
    
    # Make sure the script is executable
    chmod +x "$pkg_script"
    
    # Execute the package script with install parameter
    if bash "$pkg_script" install; then
        echo -e "${GREEN}Successfully installed $pkg_name${NC}"
        return 0
    else
        echo -e "${RED}Failed to install $pkg_name${NC}"
        return 1
    fi
}

# Function to remove a package
remove_package() {
    local pkg_name="$1"
    local pkg_script="$SIGPI_PACKAGES/pkg_$pkg_name"
    
    echo -e "${YELLOW}Removing $pkg_name...${NC}"
    
    if [ ! -f "$pkg_script" ]; then
        echo -e "${RED}Error: Package script not found: $pkg_script${NC}"
        return 1
    fi
    
    # Make sure the script is executable
    chmod +x "$pkg_script"
    
    # Execute the package script with remove parameter
    if bash "$pkg_script" remove; then
        echo -e "${GREEN}Successfully removed $pkg_name${NC}"
        return 0
    else
        echo -e "${RED}Failed to remove $pkg_name${NC}"
        return 1
    fi
}

# Function to purge a package
purge_package() {
    local pkg_name="$1"
    local pkg_script="$SIGPI_PACKAGES/pkg_$pkg_name"
    
    echo -e "${YELLOW}Purging $pkg_name...${NC}"
    
    if [ ! -f "$pkg_script" ]; then
        echo -e "${RED}Error: Package script not found: $pkg_script${NC}"
        return 1
    fi
    
    # Make sure the script is executable
    chmod +x "$pkg_script"
    
    # Execute the package script with purge parameter
    if bash "$pkg_script" purge; then
        echo -e "${GREEN}Successfully purged $pkg_name${NC}"
        return 0
    else
        echo -e "${RED}Failed to purge $pkg_name${NC}"
        return 1
    fi
}

# Main menu loop
main_menu() {
    while true; do
        # Initialize action tracking arrays
        declare -A pkg_actions
        
        while true; do
            # Build menu items array
            menu_items=()
            build_menu_items
        
        # Add action indicators to menu items based on selected actions
        local display_items=()
        for ((i=0; i<${#menu_items[@]}; i+=3)); do
            local item="${menu_items[i]}"
            local desc="${menu_items[i+1]}"
            local default="${menu_items[i+2]}"
            
            # Extract package name from item (remove padding and status)
            local pkg_name=$(echo "$item" | sed 's/[[:space:]]*[✓○][[:space:]]*$//' | sed 's/^[[:space:]]*//' | sed 's/[[:space:]]*$//')
            
            # Add action indicator if an action is set for this package
            if [ -n "${pkg_actions[$pkg_name]}" ]; then
                case "${pkg_actions[$pkg_name]}" in
                    install) item="$item [→INSTALL]" ;;
                    remove)  item="$item [→REMOVE]" ;;
                    purge)   item="$item [→PURGE]" ;;
                esac
            fi
            
            display_items+=("$item" "$desc" "$default")
        done
        
        # Get terminal dimensions
        term_height=$(tput lines)
        term_width=$(tput cols)
        
        # Set menu dimensions (use 90% of terminal width, max 120)
        menu_width=$((term_width * 9 / 10))
        [ $menu_width -gt 120 ] && menu_width=120
        [ $menu_width -lt 80 ] && menu_width=80
        
        menu_height=$((term_height - 10))
        [ $menu_height -lt 10 ] && menu_height=10
        
        list_height=$((menu_height - 8))
        [ $list_height -lt 5 ] && list_height=5
        
        # Display the checklist menu with updated items
        selected=$(whiptail --title "SIGpi Package Management Menu" \
            --checklist "Select packages (SPACE to select, ENTER when done):" \
            $menu_height $menu_width $list_height \
            "${display_items[@]}" \
            3>&1 1>&2 2>&3)
        
        # Check if user canceled
        exit_status=$?
        if [ $exit_status != 0 ]; then
            # Ask if user wants to proceed with scheduled actions or exit
            if [ ${#pkg_actions[@]} -gt 0 ]; then
                if whiptail --title "Actions Scheduled" \
                    --yesno "You have ${#pkg_actions[@]} package action(s) scheduled.\n\nDo you want to proceed with these actions?" \
                    10 60 \
                    3>&1 1>&2 2>&3; then
                    break  # Exit selection loop and proceed to confirmation
                fi
            fi
            echo "Operation canceled."
            exit 0
        fi
        
        # Remove quotes from selected items
        selected=$(echo "$selected" | tr -d '"')
        
        # Check if anything was selected
        if [ -z "$selected" ]; then
            # If no new selections but have scheduled actions, ask to proceed
            if [ ${#pkg_actions[@]} -gt 0 ]; then
                if whiptail --title "Actions Scheduled" \
                    --yesno "You have ${#pkg_actions[@]} package action(s) scheduled.\n\nDo you want to proceed with these actions?" \
                    10 60 \
                    3>&1 1>&2 2>&3; then
                    break  # Exit selection loop and proceed to confirmation
                else
                    continue
                fi
            fi
            whiptail --title "No Selection" --msgbox "No packages were selected." 8 45
            continue
        fi
        
        # Extract package names from selected items
        selected_pkgs=""
        for item in $selected; do
            # Remove action indicators, trailing status symbols and whitespace
            pkg_name=$(echo "$item" | sed 's/\[→[A-Z]*\]//' | sed 's/[[:space:]]*[✓○][[:space:]]*$//' | sed 's/^[[:space:]]*//' | sed 's/[[:space:]]*$//')
            selected_pkgs="$selected_pkgs $pkg_name"
        done
        
        # For each selected package, ask for action
        for pkg in $selected_pkgs; do
            [ -z "$pkg" ] && continue
            
            # Check current package status
            if is_package_installed "$pkg"; then
                pkg_status="[INSTALLED]"
                action_menu=("remove" "Remove package (keep configs)" \
                            "purge" "Purge package (remove all)" \
                            "cancel" "Don't change this package")
            else
                pkg_status="[NOT INSTALLED]"
                action_menu=("install" "Install package" \
                            "cancel" "Don't change this package")
            fi
            
            # If package already has an action, show current action
            current_action=""
            if [ -n "${pkg_actions[$pkg]}" ]; then
                current_action=" (Currently: ${pkg_actions[$pkg]})"
            fi
            
            action=$(whiptail --title "Select Action for: $pkg" \
                --menu "$pkg $pkg_status$current_action\n\nChoose action:" \
                16 70 4 \
                "${action_menu[@]}" \
                3>&1 1>&2 2>&3)
            
            if [ $? = 0 ]; then
                if [ "$action" = "cancel" ]; then
                    # Remove any scheduled action for this package
                    unset pkg_actions[$pkg]
                else
                    # Store the action for this package
                    pkg_actions[$pkg]="$action"
                fi
            fi
        done
        
        # Ask if user wants to select more packages or proceed
        if [ ${#pkg_actions[@]} -gt 0 ]; then
            if whiptail --title "Continue?" \
                --yesno "You have ${#pkg_actions[@]} package action(s) scheduled.\n\nSelect more packages or proceed with actions?" \
                10 60 \
                --yes-button "Select More" \
                --no-button "Proceed" \
                3>&1 1>&2 2>&3; then
                continue  # Select more packages
            else
                break  # Proceed to confirmation
            fi
        fi
    done
    
    # If no actions scheduled, exit
    if [ ${#pkg_actions[@]} -eq 0 ]; then
        whiptail --title "No Actions" --msgbox "No actions were scheduled." 8 45
        return
    fi
    
    # Separate packages by action type
    to_install=""
    to_remove=""
    to_purge=""
    
    for pkg in "${!pkg_actions[@]}"; do
        case "${pkg_actions[$pkg]}" in
            install) to_install="$to_install $pkg" ;;
            remove)  to_remove="$to_remove $pkg" ;;
            purge)   to_purge="$to_purge $pkg" ;;
        esac
    done
    
    # Trim leading spaces
    to_install=$(echo "$to_install" | sed 's/^[[:space:]]*//')
    to_remove=$(echo "$to_remove" | sed 's/^[[:space:]]*//')
    to_purge=$(echo "$to_purge" | sed 's/^[[:space:]]*//')
    
    # Confirm installations
    will_install=false
    if [ -n "$to_install" ]; then
        confirm_msg="Install the following packages?\n\n"
        for pkg in $to_install; do
            confirm_msg="${confirm_msg}  - $pkg\n"
        done
        
        if whiptail --title "Confirm Installation" \
            --yesno "$confirm_msg" \
            18 70 \
            3>&1 1>&2 2>&3; then
            will_install=true
        else
            to_install=""
        fi
    fi
    
    # Confirm removals
    will_remove=false
    if [ -n "$to_remove" ]; then
        confirm_msg="Remove the following packages?\n(Configuration files will be kept)\n\n"
        for pkg in $to_remove; do
            confirm_msg="${confirm_msg}  - $pkg\n"
        done
        
        if whiptail --title "Confirm Removal" \
            --yesno "$confirm_msg" \
            18 70 \
            3>&1 1>&2 2>&3; then
            will_remove=true
        else
            to_remove=""
        fi
    fi
    
    # Confirm purges
    will_purge=false
    if [ -n "$to_purge" ]; then
        confirm_msg="Purge the following packages?\n(All files and configs will be removed)\n\n"
        for pkg in $to_purge; do
            confirm_msg="${confirm_msg}  - $pkg\n"
        done
        
        if whiptail --title "Confirm Purge" \
            --yesno "$confirm_msg" \
            18 70 \
            3>&1 1>&2 2>&3; then
            will_purge=true
        else
            to_purge=""
        fi
    fi
    
    # Check if any actions were confirmed
    if [ "$will_install" = false ] && [ "$will_remove" = false ] && [ "$will_purge" = false ]; then
        whiptail --title "No Actions" --msgbox "No actions were confirmed." 8 45
        return
    fi
    
    # Clear screen and show progress
    clear
    echo -e "${GREEN}======================================${NC}"
    echo -e "${GREEN}  SIGpi Package Management${NC}"
    echo -e "${GREEN}======================================${NC}"
    echo ""
    
    # Process packages
    success_count=0
    fail_count=0
    failed_packages=""
    
    # Process installations
    if [ "$will_install" = true ] && [ -n "$to_install" ]; then
        echo -e "${BLUE}Installing packages...${NC}"
        echo ""
        for pkg in $to_install; do
            [ -z "$pkg" ] && continue
            if install_package "$pkg"; then
                ((success_count++))
            else
                ((fail_count++))
                failed_packages="$failed_packages\n  - $pkg (install)"
            fi
            echo ""
        done
    fi
    
    # Process removals
    if [ "$will_remove" = true ] && [ -n "$to_remove" ]; then
        echo -e "${BLUE}Removing packages...${NC}"
        echo ""
        for pkg in $to_remove; do
            [ -z "$pkg" ] && continue
            if remove_package "$pkg"; then
                ((success_count++))
            else
                ((fail_count++))
                failed_packages="$failed_packages\n  - $pkg (remove)"
            fi
            echo ""
        done
    fi
    
    # Process purges
    if [ "$will_purge" = true ] && [ -n "$to_purge" ]; then
        echo -e "${BLUE}Purging packages...${NC}"
        echo ""
        for pkg in $to_purge; do
            [ -z "$pkg" ] && continue
            if purge_package "$pkg"; then
                ((success_count++))
            else
                ((fail_count++))
                failed_packages="$failed_packages\n  - $pkg (purge)"
            fi
            echo ""
        done
    fi
    
    # Show summary
    echo -e "${GREEN}======================================${NC}"
    echo -e "${GREEN}  Operation Summary${NC}"
    echo -e "${GREEN}======================================${NC}"
    echo -e "Successful: ${GREEN}$success_count${NC}"
    
    if [ $fail_count -gt 0 ]; then
        echo -e "Failed: ${RED}$fail_count${NC}"
        echo -e "${RED}Failed packages:${NC}"
        echo -e "$failed_packages"
    fi
    
    echo ""
    read -p "Press ENTER to return to menu or Ctrl+C to exit..."
    done  # End outer while true loop
}
# Run main menu
main_menu